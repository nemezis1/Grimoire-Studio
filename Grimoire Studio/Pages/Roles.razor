@page "/roles"
@using System.Globalization
@inject NavigationManager Nav
@inject GameDataClient Client
@inject ChangeSets ChangeSets
@inject Proposals Proposals

<PageTitle>Role – Grimoire Studio</PageTitle>

<div class="title-row title-row--compact">
    <h1>Role</h1>
    <a class="button" href="roles/new">Nowa rola</a>
</div>

<div class="pinned fill-viewport">
<DataView Context="data">
    @{
        // Several scripts show the roles of any of them; several teams likewise.
        var scripts = Split(Script).Select(data.FindScript).OfType<Script>().ToList();
        var teams = Split(Team).Select(Teams.Parse).OfType<TeamInfo>().Select(t => t.Id).ToHashSet();
        var roles = data.AllRoles
            .Where(r => scripts.Count == 0 || scripts.Any(s => s.Roles.Contains(r.Id)))
            .Where(r => teams.Count == 0 || teams.Contains(r.Team))
            .Where(r => SearchText.Matches(Q ?? string.Empty, r.NamePl, r.NameEn, r.AbilityPl, r.AbilityEn, r.Id))
            .ToList();
        var descending = Sort is DescendingSort or FlatDescendingSort;

        // A–Z / Z–A without teams: one list across all teams.
        var flat = Sort is FlatSort or FlatDescendingSort;

        // Sorted by a night: only roles that wake that night, in waking order.
        Func<Role, int>? nightOrder = Sort switch
        {
            FirstNightSort => r => r.FirstNight,
            OtherNightsSort => r => r.OtherNight,
            _ => null,
        };
        if (nightOrder is not null)
        {
            roles = roles.Where(r => nightOrder(r) > 0).OrderBy(nightOrder).ToList();
        }
    }

    <div class="pinned__top">
        <div class="filters" data-fold-rows="2">
            <input class="filters__search" type="search" placeholder="Szukaj po nazwie lub zdolności…"
                   value="@Q" @oninput="e => SetParameter(QueryName, e.Value?.ToString())" />

            @* Narrow screens: scripts, teams and sorting fold behind this button. *@
            <button class="button button--ghost filters__toggle" aria-expanded="@_filtersOpen" @onclick="() => _filtersOpen = !_filtersOpen">
                Filtry@((scripts.Count > 0 ? 1 : 0) + (Sort is null ? 0 : 1) + (teams.Count > 0 ? 1 : 0) is var active and > 0 ? $" ({active})" : null)
            </button>

            <div class="filters__more @(_filtersOpen ? "filters__more--open" : null)">
            @* Scripts: tick any number; with none ticked every role is listed. *@
            <details class="multi-select multi-select--left">
                <summary>@ScriptsLabel(scripts)</summary>
                <div class="multi-select__menu">
                    @foreach (var script in data.Scripts.Scripts)
                    {
                        var ticked = scripts.Contains(script);
                        <label class="field field--inline">
                            <input type="checkbox" checked="@ticked" @onchange="() => Toggle(ScriptName, Script, script.Id)" />
                            <span>@script.Name</span>
                        </label>
                    }
                    <div class="field-row multi-select__actions">
                        <button class="button button--ghost" disabled="@(scripts.Count == data.Scripts.Scripts.Count)"
                                @onclick="() => SetParameter(ScriptName, string.Join(',', data.Scripts.Scripts.Select(s => s.Id)))">Zaznacz wszystkie</button>
                        <button class="button button--ghost" disabled="@(scripts.Count == 0)" @onclick="() => SetParameter(ScriptName, null)">Odznacz wszystkie</button>
                    </div>
                </div>
            </details>

            @* Teams: like the scripts, any number; with none ticked every team is listed. *@
            <details class="multi-select multi-select--left">
                <summary>@TeamsLabel(teams)</summary>
                <div class="multi-select__menu">
                    @foreach (var t in Teams.All)
                    {
                        <label class="field field--inline" style="@Teams.Style(t.Id)">
                            <input type="checkbox" checked="@teams.Contains(t.Id)" @onchange="() => Toggle(TeamName, Team, t.Id)" />
                            <span class="multi-select__swatch" aria-hidden="true"></span>
                            <span>@t.PluralPl</span>
                        </label>
                    }
                    <div class="field-row multi-select__actions">
                        <button class="button button--ghost" disabled="@(teams.Count == Teams.All.Count)"
                                @onclick="() => SetParameter(TeamName, string.Join(',', Teams.All.Select(t => t.Id)))">Zaznacz wszystkie</button>
                        <button class="button button--ghost" disabled="@(teams.Count == 0)" @onclick="() => SetParameter(TeamName, null)">Odznacz wszystkie</button>
                    </div>
                </div>
            </details>

            <select class="filters__select" value="@(Sort ?? string.Empty)"
                    @onchange="e => SetParameter(SortName, e.Value?.ToString())" aria-label="Sortowanie">
                <option value="">A–Z, według drużyn</option>
                <option value="@DescendingSort">Z–A, według drużyn</option>
                <option value="@FlatSort">A–Z</option>
                <option value="@FlatDescendingSort">Z–A</option>
                <option value="@FirstNightSort">Kolejność pierwszej nocy</option>
                <option value="@OtherNightsSort">Kolejność pozostałych nocy</option>
            </select>
            </div>

            <span class="filters__count muted">
                Znaleziono: @roles.Count
                @if (nightOrder is not null)
                {
                    <span> · tylko role, które budzą się @(Sort == FirstNightSort ? "pierwszej nocy" : "w pozostałe noce")</span>
                }
            </span>
        </div>
    </div>

    <div class="pinned__scroll">
        <CascadingValue Value="_status">
        @if (nightOrder is not null)
        {
            <ul class="role-grid role-grid--ordered">
                @foreach (var (role, index) in roles.Select((r, i) => (r, i + 1)))
                {
                    <RoleCard Role="role" Order="index" />
                }
            </ul>
        }
        else if (flat)
        {
            <ul class="role-grid">
                @foreach (var role in descending ? roles.OrderByDescending(r => r.NamePl, PolishOrder) : roles.OrderBy(r => r.NamePl, PolishOrder))
                {
                    <RoleCard Role="role" />
                }
            </ul>
        }
        else
        {
            @foreach (var group in roles.GroupBy(r => r.Team).OrderBy(g => Teams.Get(g.Key).Order))
            {
                <section class="role-group">
                    <h2 class="team-heading team--@(group.Key)" style="@Teams.Style(group.Key)">@Teams.Plural(group.Key) <span class="muted">(@group.Count())</span></h2>
                    <ul class="role-grid">
                        @foreach (var role in descending ? group.OrderByDescending(r => r.NamePl, PolishOrder) : group.OrderBy(r => r.NamePl, PolishOrder))
                        {
                            <RoleCard Role="role" />
                        }
                    </ul>
                </section>
            }
        }
        </CascadingValue>
    </div>
</DataView>
</div>

@code {
    private const string QueryName = "q";
    private const string TeamName = "team";
    private const string ScriptName = "script";
    private const string SortName = "sort";
    private const string FirstNightSort = "first";
    private const string OtherNightsSort = "other";
    private const string DescendingSort = "za";
    private const string FlatSort = "az-all";
    private const string FlatDescendingSort = "za-all";

    private bool _filtersOpen;
    private ChangeStatus _status = ChangeStatus.Empty;

    protected override async Task OnInitializedAsync() => _status = await ChangeStatus.LoadAsync(Client, ChangeSets, Proposals);

    private static readonly StringComparer PolishOrder = StringComparer.Create(new CultureInfo("pl-PL"), true);

    [SupplyParameterFromQuery(Name = QueryName)]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = TeamName)]
    public string? Team { get; set; }

    [SupplyParameterFromQuery(Name = ScriptName)]
    public string? Script { get; set; }

    [SupplyParameterFromQuery(Name = SortName)]
    public string? Sort { get; set; }

    // Filters live in the query string so a filtered list can be shared as a link.
    private void SetParameter(string name, string? value) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(name, string.IsNullOrWhiteSpace(value) ? null : value), replace: true);

    /// <summary>Ids of a multi-value parameter, written comma-separated (e.g. script=tb,snv).</summary>
    private static List<string> Split(string? value) =>
        (value ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    /// <summary>Adds <paramref name="id"/> to a multi-value parameter, or takes it out when it is there.</summary>
    private void Toggle(string name, string? current, string id)
    {
        var ids = Split(current);
        if (!ids.Remove(id))
        {
            ids.Add(id);
        }

        SetParameter(name, string.Join(',', ids));
    }

    private string TeamsLabel(IReadOnlySet<string> teams) => teams.Count switch
    {
        0 => "Wszystkie drużyny",
        1 => Teams.Plural(teams.First()),
        _ => $"Drużyny: {teams.Count}",
    };

    private static string ScriptsLabel(IReadOnlyList<Script> scripts) => scripts.Count switch
    {
        0 => "Wszystkie skrypty",
        1 => scripts[0].Name,
        _ => $"Skrypty: {scripts.Count}",
    };
}
