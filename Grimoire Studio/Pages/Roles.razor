@page "/roles"
@using System.Globalization
@inject NavigationManager Nav

<PageTitle>Role – Grimoire Studio</PageTitle>

<div class="title-row">
    <h1>Role</h1>
    <a class="button" href="roles/new">Nowa rola</a>
</div>

<div class="pinned fill-viewport">
<DataView Context="data">
    @{
        var scope = Script is null ? null : data.FindScript(Script);
        var team = Teams.Parse(Team);
        var roles = data.AllRoles
            .Where(r => scope is null || scope.Roles.Contains(r.Id))
            .Where(r => team is null || r.Team == team.Id)
            .Where(r => SearchText.Matches(Q ?? string.Empty, r.NamePl, r.NameEn, r.AbilityPl, r.AbilityEn, r.Id))
            .ToList();

        // Sorted by a night: only roles that wake that night, in waking order.
        Func<Role, int>? nightOrder = Sort switch
        {
            FirstNightSort => r => r.FirstNight,
            OtherNightsSort => r => r.OtherNight,
            _ => null,
        };
        if (nightOrder is not null)
        {
            roles = roles.Where(r => nightOrder(r) > 0).OrderBy(nightOrder).ToList();
        }
    }

    <div class="pinned__top">
        <div class="filters">
            <input class="filters__search" type="search" placeholder="Szukaj po nazwie lub zdolności…"
                   value="@Q" @oninput="e => SetParameter(QueryName, e.Value?.ToString())" />

            <select class="filters__select" value="@(scope?.Id ?? string.Empty)"
                    @onchange="e => SetParameter(ScriptName, e.Value?.ToString())">
                <option value="">Wszystkie skrypty</option>
                @foreach (var script in data.Scripts.Scripts)
                {
                    <option value="@script.Id">@script.Name</option>
                }
            </select>

            <select class="filters__select" value="@(nightOrder is null ? string.Empty : Sort)"
                    @onchange="e => SetParameter(SortName, e.Value?.ToString())" aria-label="Sortowanie">
                <option value="">Alfabetycznie, według drużyn</option>
                <option value="@FirstNightSort">Kolejność pierwszej nocy</option>
                <option value="@OtherNightsSort">Kolejność pozostałych nocy</option>
            </select>

            <div class="chips" role="group" aria-label="Drużyna">
                <button class="chip @(team is null ? "chip--active" : null)" @onclick="() => SetParameter(TeamName, null)">Wszystkie</button>
                @foreach (var t in Teams.All)
                {
                    <button class="chip team--@(t.Id) @(team?.Id == t.Id ? "chip--active" : null)" style="@Teams.Style(t.Id)"
                            @onclick="() => SetParameter(TeamName, t.Id)">@t.PluralPl</button>
                }
            </div>
        </div>

        <p class="muted">
            Znaleziono: @roles.Count
            @if (nightOrder is not null)
            {
                <span> · tylko role, które budzą się @(Sort == FirstNightSort ? "pierwszej nocy" : "w pozostałe noce")</span>
            }
        </p>
    </div>

    <div class="pinned__scroll">
        @if (nightOrder is not null)
        {
            <ul class="role-grid role-grid--ordered">
                @foreach (var (role, index) in roles.Select((r, i) => (r, i + 1)))
                {
                    <RoleCard Role="role" Order="index" />
                }
            </ul>
        }
        else
        {
            @foreach (var group in roles.GroupBy(r => r.Team).OrderBy(g => Teams.Get(g.Key).Order))
            {
                <section class="role-group">
                    <h2 class="team-heading team--@(group.Key)" style="@Teams.Style(group.Key)">@Teams.Plural(group.Key) <span class="muted">(@group.Count())</span></h2>
                    <ul class="role-grid">
                        @foreach (var role in group.OrderBy(r => r.NamePl, PolishOrder))
                        {
                            <RoleCard Role="role" />
                        }
                    </ul>
                </section>
            }
        }
    </div>
</DataView>
</div>

@code {
    private const string QueryName = "q";
    private const string TeamName = "team";
    private const string ScriptName = "script";
    private const string SortName = "sort";
    private const string FirstNightSort = "first";
    private const string OtherNightsSort = "other";

    private static readonly StringComparer PolishOrder = StringComparer.Create(new CultureInfo("pl-PL"), true);

    [SupplyParameterFromQuery(Name = QueryName)]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = TeamName)]
    public string? Team { get; set; }

    [SupplyParameterFromQuery(Name = ScriptName)]
    public string? Script { get; set; }

    [SupplyParameterFromQuery(Name = SortName)]
    public string? Sort { get; set; }

    // Filters live in the query string so a filtered list can be shared as a link.
    private void SetParameter(string name, string? value) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(name, string.IsNullOrWhiteSpace(value) ? null : value), replace: true);
}
