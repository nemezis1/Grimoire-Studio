@page "/changes"
@inject GameDataClient Client
@inject ChangeSets ChangeSets
@inject Proposals Proposals

<PageTitle>Moje zmiany – Grimoire Studio</PageTitle>

<div class="title-row">
    <h1>Moje zmiany</h1>
    <div class="script-actions">
        <button class="button button--ghost" disabled="@(_changes?.Count is null or 0)" @onclick="ExportAsync">Eksportuj do pliku</button>
        <label class="button button--ghost button--file">
            Importuj z pliku…
            <InputFile accept=".json,application/json" OnChange="ImportAsync" />
        </label>
        @if (_changes?.Count > 0)
        {
            <button class="button button--ghost" @onclick="ClearAsync">@(_confirmClear ? "Na pewno usunąć wszystko?" : "Usuń wszystkie zmiany")</button>
        }
    </div>
</div>
<p class="muted">
    Role, skrypty, drużyny i jinxy zmienione w tej przeglądarce, widoczne tylko dla Ciebie. Możesz je zgłosić do wiki:
    po zatwierdzeniu przez administratora staną się częścią wiki. Eksport zapisuje je do pliku: to kopia zapasowa i sposób
    na przeniesienie zmian do innej przeglądarki.
</p>
<div class="field-row">
    <label class="field field--inline">
        <input type="checkbox" @bind="_replaceOnImport" />
        <span>Import zastępuje wszystkie obecne zmiany (bez zaznaczenia: dopisuje i nadpisuje te same identyfikatory)</span>
    </label>
</div>

@if (_message is not null)
{
    <p class="notice @(_messageIsError ? "notice--error" : null)">@_message</p>
}

@if (_data is null || _base is null || _changes is null)
{
    <p class="notice">Wczytywanie…</p>
}
else
{
    @if (_changes.Count > 0)
    {
        <section class="panel form">
            <h2>Zgłoś do wiki</h2>
            <div class="field-row">
                <label class="field">
                    <span>Podpis</span>
                    <input type="text" @bind="_author" @bind:event="oninput" placeholder="np. nick z Discorda" />
                </label>
                <label class="field">
                    <span>Komentarz dla administratora</span>
                    <input type="text" @bind="_comment" @bind:event="oninput" placeholder="co i dlaczego" />
                </label>
            </div>
            <div class="field-row">
                <label class="field field--inline">
                    <input type="checkbox" @bind="_clearAfterSubmit" />
                    <span>Po zgłoszeniu usuń zgłoszone zmiany z moich (zobaczysz je w wiki po zatwierdzeniu)</span>
                </label>
            </div>
            <div class="field-row">
                <span class="muted small">Zgłoszone zostaną zmiany zaznaczone na liście poniżej.</span>
                <button class="button button--ghost" @onclick="() => _selected.UnionWith(_changes.Keys())">Zaznacz wszystkie</button>
                <button class="button button--ghost" @onclick="() => _selected.Clear()">Odznacz wszystkie</button>
                <button class="button" disabled="@(string.IsNullOrWhiteSpace(_author) || _selected.Count == 0)" @onclick="SubmitAsync">Zgłoś do wiki (@ProposalText.Changes(_selected.Count))</button>
            </div>
        </section>
    }

    <ChangeSetView Changes="_changes" Base="_base" Data="_data" EditLinks="true" OnRemove="RemoveAsync"
                   Selected="_changes.Count > 0 ? _selected : null" SelectedChanged="() => { }">
        <p>Nie ma lokalnych zmian. Rolę, skrypt lub drużynę zmienisz przyciskiem „Edytuj” na ich stronie.</p>
    </ChangeSetView>

    @if (_mine.Count > 0)
    {
        <h2>Moje zgłoszenia</h2>
        <ul class="change-list">
            @foreach (var proposal in _mine)
            {
                <li>
                    <span class="change-list__what">
                        @proposal.CreatedAt.ToLocalTime().ToString("g") · @ProposalText.Changes(proposal.Changes.Count)
                        <span class="local-badge">@ProposalText.Status(proposal)</span>
                        @if (proposal.Comment.Length > 0)
                        {
                            <span class="change-list__fields">@proposal.Comment</span>
                        }
                    </span>
                    <ProposalDetails Proposal="proposal" Base="@(proposal.Status == ProposalStatus.Pending ? _base : _original!)" Data="_data" />
                </li>
            }
        </ul>
    }
}

@code {
    private const long MaxImportBytes = 50 * 1024 * 1024;
    private const string AuthorKey = "grimoire-studio.author";

    [Inject]
    private LocalStore Store { get; set; } = default!;

    private LocalChanges Personal => ChangeSets.Personal;

    private GameData? _data;
    private GameData? _base;
    private GameData? _original;
    private LocalBackup? _changes;
    private List<Proposal> _mine = [];
    private bool _replaceOnImport;
    private bool _confirmClear;
    private bool _clearAfterSubmit = true;

    /// <summary>Keys of the changes ticked for the proposal (<see cref="LocalBackup.Keys"/>).</summary>
    private readonly HashSet<string> _selected = [];
    private HashSet<string> _known = [];
    private string _author = string.Empty;
    private string _comment = string.Empty;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        _author = await Store.GetSettingAsync(AuthorKey) ?? string.Empty;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _data = await Client.GetAsync();
        _base = await Client.GetWikiAsync();
        _original = await Client.GetOriginalAsync();
        _changes = await Personal.GetAllAsync();

        // Changes seen for the first time start selected; unticked ones stay unticked, removed ones drop out.
        var keys = _changes.Keys().ToHashSet();
        _selected.IntersectWith(keys);
        _selected.UnionWith(keys.Except(_known));
        _known = keys;

        _mine = (await Proposals.GetAllAsync()).OrderByDescending(p => p.CreatedAt).ToList();
    }

    private async Task RemoveAsync(string key)
    {
        await Personal.RemoveAsync(key);
        await ReloadAsync();
    }

    private async Task SubmitAsync()
    {
        var proposal = new Proposal
        {
            Id = Guid.NewGuid().ToString("N"),
            Author = _author.Trim(),
            Comment = _comment.Trim(),
            CreatedAt = DateTimeOffset.Now,
            Changes = _changes!.Only(_selected),
        };

        if (!await Proposals.SaveAsync(proposal))
        {
            Show("Przeglądarka nie pozwoliła zapisać zgłoszenia (tryb prywatny lub brak miejsca).", error: true);
            return;
        }

        await Store.SetSettingAsync(AuthorKey, proposal.Author);
        if (_clearAfterSubmit)
        {
            foreach (var key in proposal.Changes.Keys())
            {
                await Personal.RemoveAsync(key);
            }
        }

        _comment = string.Empty;
        Show($"Zgłoszono: {ProposalText.Changes(proposal.Changes.Count)}. Czekają na zatwierdzenie w panelu administratora.");
        await ReloadAsync();
    }

    private async Task ExportAsync()
    {
        await Store.DownloadAsync($"grimoire-studio-zmiany-{DateTime.Now:yyyy-MM-dd}.json", await Personal.ExportAsync());
        Show($"Wyeksportowano: {ProposalText.Changes(_changes!.Count)}.");
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            var count = await Personal.ImportAsync(await reader.ReadToEndAsync(), _replaceOnImport);
            Show($"Zaimportowano: {ProposalText.Changes(count)} z pliku {e.File.Name}.");
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            Show(ex.Message, error: true);
        }

        await ReloadAsync();
    }

    private async Task ClearAsync()
    {
        if (!_confirmClear)
        {
            _confirmClear = true;
            return;
        }

        _confirmClear = false;
        await Personal.ClearAsync();
        Show("Usunięto wszystkie lokalne zmiany.");
        await ReloadAsync();
    }

    private void Show(string message, bool error = false)
    {
        _message = message;
        _messageIsError = error;
    }
}
