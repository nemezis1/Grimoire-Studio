@page "/scripts/new"
@page "/scripts/{Id}/edit"
@inject GameDataClient Client
@inject ChangeSets Changes
@inject NavigationManager Nav
@inject RolePreferences Preferences

<PageTitle>@(IsNew ? "Nowy skrypt" : $"Edycja: {_name}") – Grimoire Studio</PageTitle>

<header class="page-head">
    <h1>@(IsNew ? "Nowy skrypt" : "Edycja skryptu")</h1>
    <p class="muted">Zmiany są zapisywane tylko w tej przeglądarce. Skrypt z danych strony zostaje nietknięty i można do niego wrócić.</p>
</header>

@if (_data is null)
{
    <p class="notice">Wczytywanie…</p>
}
else if (!IsNew && _notFound)
{
    <p>Skrypt <code>@Id</code> nie istnieje. <a href="scripts">Wróć do listy skryptów</a>.</p>
}
else
{
    var selected = _selected.Select(_data.FindRole).OfType<Role>().ToList();

    <div class="script-editor fill-viewport">
        <section class="panel">
            @* Name, id and picture in one row without captions (placeholders and tooltips name them); they wrap on narrow screens. *@
            @* Narrow screens: name, id and picture fold into this one line (open for a new script). *@
            <button class="button button--ghost script-head__toggle" aria-expanded="@HeadOpen" @onclick="() => _headOpen = !HeadOpen">
                @(string.IsNullOrWhiteSpace(_name) ? "Nazwa i obrazek" : _name) @(HeadOpen ? "▴" : "✎")
            </button>
            <div class="script-head @(HeadOpen ? "script-head--open" : null)">
                <label class="field script-head__name">
                    <input type="text" @bind="_name" @bind:event="oninput" placeholder="Nazwa skryptu" aria-label="Nazwa skryptu" title="Nazwa skryptu" />
                </label>
                @if (IsNew)
                {
                    <label class="field script-head__id">
                        <input type="text" value="@EffectiveId" @oninput="e => _id = e.Value?.ToString()" placeholder="Identyfikator" aria-label="Identyfikator (małe litery i cyfry)" title="Identyfikator (małe litery i cyfry)" />
                    </label>
                }
                <div class="field script-head__image">
                    <div class="script-image">
                        <img class="script-image__preview" src="@(_image ?? GameDataClient.EditionIconUrl(_iconName))" alt="" />
                        <label class="button button--ghost button--file" title="Zmniejszany do @MaxImageSize px; widoczny na liście skryptów, stronie skryptu i wydruku">
                            Wczytaj obrazek…
                            <InputFile accept="image/png,image/jpeg,image/webp" OnChange="UploadImageAsync" />
                        </label>
                        @if (_image is not null)
                        {
                            <button class="button button--ghost" @onclick="() => _image = null">Usuń własny</button>
                        }
                    </div>
                </div>
            </div>
            @if (IsNew && IdError() is { } idError)
            {
                <p class="notice notice--error">@idError</p>
            }

            @* Search and filters as on the role list: one row on wide screens; on narrow ones the filters fold behind "Filtry". *@
            <div class="filters script-filters" data-fold-rows="2">
                <input class="filters__search" type="search" placeholder="Szukaj roli lub zdolności…" @bind="_query" @bind:event="oninput" />
                <button class="button button--ghost filters__toggle" aria-expanded="@_filtersOpen" @onclick="() => _filtersOpen = !_filtersOpen">
                    Filtry@(ActiveFilters is var active and > 0 ? $" ({active})" : null)
                </button>
                <div class="filters__more @(_filtersOpen ? "filters__more--open" : null)">
                <ScriptFilter Scripts="_data.Scripts.Scripts" Ticked="_scripts" Toggled="id => Flip(_scripts, id)"
                              AllSet="all => SetAll(_scripts, all ? _data.Scripts.Scripts.Select(s => s.Id) : Enumerable.Empty<string>())" />
                <TeamFilter Ticked="_teams" Toggled="id => Flip(_teams, id)" AllSet="all => SetAll(_teams, all ? Teams.All.Select(t => t.Id) : Enumerable.Empty<string>())" />
                <PreferenceFilter Shown="_shown" Toggled="kind => Flip(_shown, kind)" />
                <OriginFilter Ticked="_origins" Toggled="kind => Flip(_origins, kind)" />
                <details class="multi-select multi-select--left">
                    <summary>Warunki@(_filters.Count > 0 ? $" ({_filters.Count})" : null)</summary>
                    <div class="multi-select__menu">
                        @foreach (var (label, _) in RoleFilters)
                        {
                            <label class="field field--inline">
                                <input type="checkbox" checked="@_filters.Contains(label)" @onchange="e => ToggleFilter(label, e.Value is true)" />
                                <span>@label</span>
                            </label>
                        }
                        <p class="muted small">Pokazuje role spełniające wszystkie zaznaczone warunki.</p>
                        <button class="button button--ghost" disabled="@(_filters.Count == 0)" @onclick="() => _filters.Clear()">Wyczyść warunki</button>
                    </div>
                </details>
                </div>
            </div>

            <ul class="role-picker">
                @foreach (var role in Matching()
                    .OrderBy(r => Teams.Get(r.Team).Order)
                    .ThenBy(r => r.NamePl, StringComparer.CurrentCulture))
                {
                    var isSelected = _selected.Contains(role.Id);
                    <li>
                        <button class="role-toggle team--@(role.Team) @(isSelected ? "role-toggle--on" : null)" style="@Teams.Style(role.Team)"
                                aria-pressed="@isSelected" @onclick="() => Toggle(role.Id)">
                            <RoleIcon Role="role" Size="sm" />
                            <span class="role-toggle__text">
                                <span class="role-toggle__name">@role.NamePl</span>
                                <span class="role-toggle__ability">@role.AbilityPl</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>
        </section>

        <aside class="panel script-editor__summary">
            <h2>Wybrane role (@selected.Count)</h2>
            <p class="muted small">
                @string.Join(" · ", Teams.All
                    .Select(t => (Team: t.Id, Count: selected.Count(r => r.Team == t.Id)))
                    .Where(x => x.Count > 0)
                    .Select(x => $"{x.Count} {Teams.Plural(x.Team).ToLowerInvariant()}"))
            </p>
            <ScriptAnalysisView Data="_data" Roles="selected" OnAdd="Add" />

            @* Random roles around the chosen ones, from the roles the filters leave on the list. *@
            <details class="script-generator">
                <summary>Losuj skrypt</summary>
                <p class="muted small">
                    Wybrane role zostają; brakujące do podanej liczby w każdej drużynie są losowane spośród ról, które
                    zostawiają filtry i wyszukiwanie po lewej.
                </p>
                <div class="script-generator__counts">
                    @foreach (var (teamId, _) in ScriptGenerator.Usual)
                    {
                        var id = teamId;
                        <label class="field" style="@Teams.Style(id)">
                            <span class="team-heading team--@(id)">@Teams.Plural(id)</span>
                            <input type="number" min="0" max="40" value="@_wanted[id]"
                                   @onchange="e => _wanted[id] = int.TryParse(e.Value?.ToString(), out var n) ? Math.Clamp(n, 0, 40) : _wanted[id]" />
                        </label>
                    }
                </div>
                <div class="field-row">
                    <button class="button" @onclick="Generate">Uzupełnij losowo</button>
                    <button class="button button--ghost" disabled="@(_generated.Count == 0)" title="Losowane role zmieniają się, wybrane ręcznie zostają"
                            @onclick="Reroll">Losuj ponownie</button>
                </div>
                @if (_generatorMessage is not null)
                {
                    <p class="muted small">@_generatorMessage</p>
                }
            </details>
            <div class="script-editor__selected">
                @foreach (var group in selected.GroupBy(r => r.Team).OrderBy(g => Teams.Get(g.Key).Order))
                {
                    <h3 class="team-heading team--@(group.Key)" style="@Teams.Style(group.Key)">@Teams.Plural(group.Key)</h3>
                    <ul class="selected-roles">
                        @foreach (var role in group)
                        {
                            <li>
                                <RoleIcon Role="role" Size="sm" />
                                <span>@role.NamePl</span>
                                <button title="Usuń ze skryptu" @onclick="() => Toggle(role.Id)">✕</button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="script-editor__actions">
                @if (_error is not null)
                {
                    <p class="notice notice--error">@_error</p>
                }
                <div class="field-row">
                    <button class="button" @onclick="SaveAsync">Zapisz</button>
                    <a class="button button--ghost" href="@(IsNew ? "scripts" : $"scripts/{Id}")">Anuluj</a>
                </div>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private bool IsNew => Id is null;

    private bool? _headOpen;
    private bool _filtersOpen;

    // Filters as on the role list: scripts and teams (none ticked: all), likes (disliked left out at first) and origin.
    private readonly HashSet<string> _scripts = [];
    private readonly HashSet<string> _teams = [];
    private readonly HashSet<string> _shown = [.. PreferenceFilter.Default];
    private readonly HashSet<string> _origins = [.. OriginFilter.All];

    /// <summary>Filters changed from their defaults, for the "Filtry" button on narrow screens.</summary>
    private int ActiveFilters =>
        (_scripts.Count > 0 ? 1 : 0) + (_teams.Count > 0 ? 1 : 0) + (_shown.SetEquals(PreferenceFilter.Default) ? 0 : 1)
        + (_origins.Count == OriginFilter.All.Length ? 0 : 1) + (_filters.Count > 0 ? 1 : 0);

    private static void Flip(HashSet<string> set, string id)
    {
        if (!set.Remove(id))
        {
            set.Add(id);
        }
    }

    private static void SetAll(HashSet<string> set, IEnumerable<string> ids)
    {
        set.Clear();
        set.UnionWith(ids);
    }

    private bool HeadOpen => _headOpen ?? IsNew;

    private GameData? _data;
    private Script? _existing;
    private bool _notFound;
    private string _name = string.Empty;
    private List<string> _selected = [];
    private string _query = string.Empty;
    private string? _error;
    private readonly HashSet<string> _filters = [];

    /// <summary>Conditions offered in the "Filtry" dropdown; checked ones must all hold.</summary>
    private IReadOnlyList<(string Label, Func<Role, bool> Matches)> RoleFilters =>
    [
        ("Budzi się pierwszej nocy", r => r.WakesFirstNight),
        ("Budzi się w pozostałe noce", r => r.WakesOtherNights),
        ("Nie budzi się", r => !r.WakesFirstNight && !r.WakesOtherNights),
        ("Zmienia przygotowanie gry", r => r.Setup),
        ("Ma przypominajki", r => r.RemindersPl.Count + r.RemindersGlobalPl.Count > 0),
        ("Ma jinxy", r => _data!.JinxesFor(r.Id).Count > 0),
        ("Niewybrane w skrypcie", r => !_selected.Contains(r.Id)),
    ];

    private void ToggleFilter(string label, bool on)
    {
        if (on)
        {
            _filters.Add(label);
        }
        else
        {
            _filters.Remove(label);
        }
    }

    /// <summary>Id typed for a new script; null until edited, then the suggestion from the name is used.</summary>
    private string? _id;

    private string EffectiveId => (_id ?? NewId()).Trim();

    private const int MaxImageSize = 512;
    private const long MaxUploadBytes = 10 * 1024 * 1024;

    /// <summary>Script to copy into a new one, e.g. /scripts/new?from=tb (the "Duplikuj" button).</summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    [Inject]
    private LocalStore Store { get; set; } = default!;

    private string _iconName = "custom";

    /// <summary>Uploaded picture (data URL); null shows the edition icon <see cref="_iconName"/>.</summary>
    private string? _image;

    protected override async Task OnParametersSetAsync()
    {
        await Preferences.LoadAsync();
        _data = await Client.GetAsync();
        _existing = Id is null ? null : _data.FindScript(Id);
        _notFound = Id is not null && _existing is null;

        var source = _existing ?? (IsNew && From is not null ? _data.FindScript(From) : null);
        _name = _existing?.Name ?? (source is null ? string.Empty : $"{source.Name} (kopia)");
        _selected = source?.Roles.ToList() ?? [];
        _iconName = source?.IconName ?? "custom";
        _image = source?.Image;
    }

    private async Task UploadImageAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            using var stream = e.File.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _image = await Store.ResizeImageAsync($"data:{e.File.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}", MaxImageSize);
        }
        catch (IOException)
        {
            _error = $"Plik jest za duży (maksymalnie {MaxUploadBytes / 1024 / 1024} MB).";
        }
        catch (JSException)
        {
            _error = "Nie można odczytać obrazka.";
        }
    }

    private void Toggle(string roleId)
    {
        if (!_selected.Remove(roleId))
        {
            _selected.Add(roleId);
        }

        // Taken out or picked by hand: no longer a drawn role that "Losuj ponownie" may change.
        _generated.Remove(roleId);
    }

    /// <summary>Roles the filters and the search leave on the list.</summary>
    private IEnumerable<Role> Matching()
    {
        var scripts = _data!.Scripts.Scripts.Where(s => _scripts.Contains(s.Id)).ToList();
        return _data.AllRoles
            .Where(r => scripts.Count == 0 || scripts.Any(s => s.Roles.Contains(r.Id)))
            .Where(r => _teams.Count == 0 || _teams.Contains(r.Team))
            .Where(r => _shown.Contains(PreferenceFilter.KindOf(Preferences, r.Id)))
            .Where(r => _origins.Contains(OriginFilter.KindOf(r)))
            .Where(r => SearchText.Matches(_query, r.NamePl, r.NameEn, r.Id, r.AbilityPl, r.AbilityEn))
            .Where(r => RoleFilters.Where(f => _filters.Contains(f.Label)).All(f => f.Matches(r)));
    }

    /// <summary>How many roles of each counted team the drawn script should have.</summary>
    private readonly Dictionary<string, int> _wanted = ScriptGenerator.Usual.ToDictionary(t => t.Team, t => t.Count);

    /// <summary>Roles added by the last draws and still on the script; "Losuj ponownie" swaps them for others.</summary>
    private readonly HashSet<string> _generated = [];
    private string? _generatorMessage;

    /// <summary>Adds random roles from the list to reach the wanted counts; the chosen ones stay.</summary>
    private void Generate()
    {
        var chosen = _selected.Select(_data!.FindRole).OfType<Role>().ToList();
        var added = ScriptGenerator.Fill(_data, chosen, Matching(), _wanted, Random.Shared);
        foreach (var role in added)
        {
            _selected.Add(role.Id);
            _generated.Add(role.Id);
        }

        var script = chosen.Concat(added).ToList();
        var missing = ScriptGenerator.Usual
            .Select(t => (t.Team, Missing: _wanted[t.Team] - script.Count(r => r.Team == t.Team)))
            .Where(x => x.Missing > 0)
            .Select(x => $"{Teams.Plural(x.Team).ToLowerInvariant()}: {x.Missing}")
            .ToList();
        _generatorMessage = (added.Count == 0 ? "Nic nie dolosowano." : $"Dolosowano ról: {added.Count}.")
            + (missing.Count == 0 ? null : $" Na liście zabrakło ról ({string.Join(", ", missing)}); zmień filtry, żeby losować z większej puli.");
    }

    /// <summary>Takes out the drawn roles and draws again; roles chosen by hand stay.</summary>
    private void Reroll()
    {
        _selected.RemoveAll(_generated.Contains);
        _generated.Clear();
        Generate();
    }

    private void Add(string roleId)
    {
        if (!_selected.Contains(roleId))
        {
            _selected.Add(roleId);
        }
    }

    /// <summary>Format and uniqueness of a new script's id (against the data folder and scripts saved locally).</summary>
    private string? IdError()
    {
        if (!IsNew)
        {
            return null;
        }

        var id = EffectiveId;
        if (id.Length == 0)
        {
            // With no name yet the empty id is expected; saving asks for the name first.
            return string.IsNullOrWhiteSpace(_name) ? null : "Podaj identyfikator skryptu.";
        }

        if (!DataValidator.IsValidId(id))
        {
            return "Identyfikator może zawierać tylko małe litery (bez polskich znaków) i cyfry.";
        }

        return _data?.FindScript(id) is { } other ? $"Skrypt o identyfikatorze „{id}” już istnieje ({other.Name})." : null;
    }

    /// <summary>
    /// Id for a new script: the name in lowercase letters and digits, numbered when already taken; empty while there is
    /// no name.
    /// </summary>
    private string NewId()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            return string.Empty;
        }

        var baseId = new string(SearchText.Fold(_name).Where(char.IsAsciiLetterOrDigit).ToArray());
        if (baseId.Length == 0)
        {
            baseId = "skrypt";
        }

        var id = baseId;
        for (var n = 2; _data?.FindScript(id) is not null; n++)
        {
            id = $"{baseId}{n}";
        }

        return id;
    }

    private async Task SaveAsync()
    {
        if (IdError() is { } idError)
        {
            _error = idError;
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Podaj nazwę skryptu.";
            return;
        }

        if (_selected.Count == 0)
        {
            _error = "Wybierz co najmniej jedną rolę.";
            return;
        }

        // Roles are stored in sheet order: by team, then as they appear on the list.
        var roles = _selected
            .Select(_data!.FindRole)
            .OfType<Role>()
            .OrderBy(r => Teams.Get(r.Team).Order)
            .Select(r => r.Id)
            .ToList();

        var id = _existing?.Id ?? EffectiveId;
        var script = (_existing ?? new Script { Id = id, Name = string.Empty }) with
        {
            Name = _name.Trim(),
            Roles = roles,

            // An edition icon named like the script (tb for tb) needs no override.
            CustomIcon = _iconName == id ? string.Empty : _iconName,
            Image = _image,
        };

        if (!await (await Changes.GetCurrentAsync()).Scripts.SaveAsync(script))
        {
            _error = "Przeglądarka nie pozwoliła zapisać skryptu (tryb prywatny lub brak miejsca).";
            return;
        }

        Nav.NavigateTo(Changes.Reviewing is not null ? "admin" : $"scripts/{script.Id}");
    }
}
