@page "/scripts/new"
@page "/scripts/{Id}/edit"
@inject GameDataClient Client
@inject LocalScripts Local
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Nowy skrypt" : $"Edycja: {_name}") – Grimoire Studio</PageTitle>

<h1>@(IsNew ? "Nowy skrypt" : "Edycja skryptu")</h1>
<p class="muted">Zmiany są zapisywane tylko w tej przeglądarce. Skrypt z danych strony zostaje nietknięty i można do niego wrócić.</p>

@if (_data is null)
{
    <p class="notice">Wczytywanie…</p>
}
else if (!IsNew && _notFound)
{
    <p>Skrypt <code>@Id</code> nie istnieje. <a href="scripts">Wróć do listy skryptów</a>.</p>
}
else
{
    var selected = _selected.Select(_data.FindRole).OfType<Role>().ToList();
    var team = Teams.Parse(_team);

    <div class="script-editor fill-viewport">
        <section class="panel">
            <label class="field">
                <span>Nazwa skryptu</span>
                <input type="text" @bind="_name" @bind:event="oninput" placeholder="np. Pełnia Zła" />
            </label>
            @if (IsNew)
            {
                <label class="field">
                    <span>Identyfikator (małe litery i cyfry)</span>
                    <input type="text" value="@EffectiveId" @oninput="e => _id = e.Value?.ToString()" />
                </label>
                @if (IdError() is { } idError)
                {
                    <p class="notice notice--error">@idError</p>
                }
            }

            <div class="filters">
                <input class="filters__search" type="search" placeholder="Szukaj roli lub zdolności…" @bind="_query" @bind:event="oninput" />
                <details class="multi-select">
                    <summary>Filtry@(_filters.Count > 0 ? $" ({_filters.Count})" : null)</summary>
                    <div class="multi-select__menu">
                        @foreach (var (label, _) in RoleFilters)
                        {
                            <label class="field field--inline">
                                <input type="checkbox" checked="@_filters.Contains(label)" @onchange="e => ToggleFilter(label, e.Value is true)" />
                                <span>@label</span>
                            </label>
                        }
                        <p class="muted small">Pokazuje role spełniające wszystkie zaznaczone warunki.</p>
                        <button class="button button--ghost" disabled="@(_filters.Count == 0)" @onclick="() => _filters.Clear()">Wyczyść filtry</button>
                    </div>
                </details>
            </div>
            <div class="chips">
                <button class="chip @(team is null ? "chip--active" : null)" @onclick='() => _team = null'>Wszystkie</button>
                @foreach (var t in Teams.All)
                {
                    <button class="chip team--@(t.Id) @(team?.Id == t.Id ? "chip--active" : null)" style="@Teams.Style(t.Id)" @onclick="() => _team = t.Id">@t.PluralPl</button>
                }
            </div>

            <ul class="role-picker">
                @foreach (var role in _data.AllRoles
                    .Where(r => team is null || r.Team == team.Id)
                    .Where(r => SearchText.Matches(_query, r.NamePl, r.NameEn, r.Id, r.AbilityPl, r.AbilityEn))
                    .Where(r => RoleFilters.Where(f => _filters.Contains(f.Label)).All(f => f.Matches(r)))
                    .OrderBy(r => Teams.Get(r.Team).Order)
                    .ThenBy(r => r.NamePl, StringComparer.CurrentCulture))
                {
                    var isSelected = _selected.Contains(role.Id);
                    <li>
                        <button class="role-toggle team--@(role.Team) @(isSelected ? "role-toggle--on" : null)" style="@Teams.Style(role.Team)"
                                aria-pressed="@isSelected" @onclick="() => Toggle(role.Id)">
                            <RoleIcon Role="role" Size="sm" />
                            <span class="role-toggle__text">
                                <span class="role-toggle__name">@role.NamePl</span>
                                <span class="role-toggle__ability">@role.AbilityPl</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>
        </section>

        <aside class="panel script-editor__summary">
            <h2>Wybrane role (@selected.Count)</h2>
            <p class="muted small">
                @string.Join(" · ", Teams.All
                    .Select(t => (Team: t.Id, Count: selected.Count(r => r.Team == t.Id)))
                    .Where(x => x.Count > 0)
                    .Select(x => $"{x.Count} {Teams.Plural(x.Team).ToLowerInvariant()}"))
            </p>
            @foreach (var group in selected.GroupBy(r => r.Team).OrderBy(g => Teams.Get(g.Key).Order))
            {
                <h3 class="team-heading team--@(group.Key)" style="@Teams.Style(group.Key)">@Teams.Plural(group.Key)</h3>
                <ul class="selected-roles">
                    @foreach (var role in group)
                    {
                        <li>
                            <RoleIcon Role="role" Size="sm" />
                            <span>@role.NamePl</span>
                            <button title="Usuń ze skryptu" @onclick="() => Toggle(role.Id)">✕</button>
                        </li>
                    }
                </ul>
            }

            @if (_error is not null)
            {
                <p class="notice notice--error">@_error</p>
            }
            <div class="field-row">
                <button class="button" @onclick="SaveAsync">Zapisz</button>
                <a class="button button--ghost" href="@(IsNew ? "scripts" : $"scripts/{Id}")">Anuluj</a>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private bool IsNew => Id is null;

    private GameData? _data;
    private Script? _existing;
    private bool _notFound;
    private string _name = string.Empty;
    private List<string> _selected = [];
    private string _query = string.Empty;
    private string? _team;
    private string? _error;
    private readonly HashSet<string> _filters = [];

    /// <summary>Conditions offered in the "Filtry" dropdown; checked ones must all hold.</summary>
    private IReadOnlyList<(string Label, Func<Role, bool> Matches)> RoleFilters =>
    [
        ("Budzi się pierwszej nocy", r => r.WakesFirstNight),
        ("Budzi się w pozostałe noce", r => r.WakesOtherNights),
        ("Nie budzi się", r => !r.WakesFirstNight && !r.WakesOtherNights),
        ("Zmienia przygotowanie gry", r => r.Setup),
        ("Ma przypominajki", r => r.RemindersPl.Count + r.RemindersGlobalPl.Count > 0),
        ("Ma jinxy", r => _data!.JinxesFor(r.Id).Count > 0),
        ("Niewybrane w skrypcie", r => !_selected.Contains(r.Id)),
    ];

    private void ToggleFilter(string label, bool on)
    {
        if (on)
        {
            _filters.Add(label);
        }
        else
        {
            _filters.Remove(label);
        }
    }

    /// <summary>Id typed for a new script; null until edited, then the suggestion from the name is used.</summary>
    private string? _id;

    private string EffectiveId => (_id ?? NewId()).Trim();

    protected override async Task OnParametersSetAsync()
    {
        _data = await Client.GetAsync();
        _existing = Id is null ? null : _data.FindScript(Id);
        _notFound = Id is not null && _existing is null;
        _name = _existing?.Name ?? string.Empty;
        _selected = _existing?.Roles.ToList() ?? [];
    }

    private void Toggle(string roleId)
    {
        if (!_selected.Remove(roleId))
        {
            _selected.Add(roleId);
        }
    }

    /// <summary>Format and uniqueness of a new script's id (against the data folder and scripts saved locally).</summary>
    private string? IdError()
    {
        if (!IsNew)
        {
            return null;
        }

        var id = EffectiveId;
        if (!DataValidator.IsValidId(id))
        {
            return "Identyfikator może zawierać tylko małe litery (bez polskich znaków) i cyfry.";
        }

        return _data?.FindScript(id) is { } other ? $"Skrypt o identyfikatorze „{id}” już istnieje ({other.Name})." : null;
    }

    /// <summary>Id for a new script: the name in lowercase letters and digits, numbered when already taken.</summary>
    private string NewId()
    {
        var baseId = new string(SearchText.Fold(_name).Where(char.IsAsciiLetterOrDigit).ToArray());
        if (baseId.Length == 0)
        {
            baseId = "skrypt";
        }

        var id = baseId;
        for (var n = 2; _data?.FindScript(id) is not null; n++)
        {
            id = $"{baseId}{n}";
        }

        return id;
    }

    private async Task SaveAsync()
    {
        if (IdError() is { } idError)
        {
            _error = idError;
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Podaj nazwę skryptu.";
            return;
        }

        if (_selected.Count == 0)
        {
            _error = "Wybierz co najmniej jedną rolę.";
            return;
        }

        // Roles are stored in sheet order: by team, then as they appear on the list.
        var roles = _selected
            .Select(_data!.FindRole)
            .OfType<Role>()
            .OrderBy(r => Teams.Get(r.Team).Order)
            .Select(r => r.Id)
            .ToList();

        var script = _existing is null
            ? new Script { Id = EffectiveId, Name = _name.Trim(), Roles = roles, CustomIcon = "custom" }
            : _existing with { Name = _name.Trim(), Roles = roles };

        if (!await Local.SaveAsync(script))
        {
            _error = "Przeglądarka nie pozwoliła zapisać skryptu (tryb prywatny lub brak miejsca).";
            return;
        }

        Nav.NavigateTo($"scripts/{script.Id}");
    }
}
