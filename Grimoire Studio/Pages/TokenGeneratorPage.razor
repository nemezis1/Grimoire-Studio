@page "/generator"
@using Grimoire_Studio.Generator
@using System.Globalization
@inject GameDataClient Client
@inject TokenRenderer Renderer
@inject LocalRoles LocalRoleIcons
@inject NavigationManager Nav

<PageTitle>Generator tokenów – Grimoire Studio</PageTitle>

<h1>Generator tokenów</h1>

<div class="generator fill-viewport">
    <div class="generator__controls">
        <section class="panel">
            <h2>Preset</h2>
            <p class="muted small">Zapisuje wygląd tokena (czcionki, rozmiary, kolory, położenie, rozmiar wydruku) w tej przeglądarce. Treść i obrazki nie są zapisywane.</p>
            <div class="field-row">
                <label class="field">
                    <span>Zapisane presety</span>
                    <select value="@_selectedPreset" @onchange="e => ApplyPreset(e.Value?.ToString())">
                        <option value="">— wybierz —</option>
                        @foreach (var preset in _presets)
                        {
                            <option value="@preset.Name">@preset.Name</option>
                        }
                    </select>
                </label>
                <button class="button button--ghost" disabled="@(_selectedPreset.Length == 0)" @onclick="DeletePresetAsync">Usuń</button>
            </div>
            <div class="field-row">
                <label class="field">
                    <span>Nazwa nowego presetu</span>
                    <input type="text" @bind="_presetName" @bind:event="oninput" placeholder="np. Mieszkańcy 5 cm" />
                </label>
                <button class="button" disabled="@string.IsNullOrWhiteSpace(_presetName)" @onclick="SavePresetAsync">Zapisz</button>
            </div>
            <button class="button button--ghost" @onclick="ResetStyle">Przywróć ustawienia domyślne</button>
            @if (_presetMessage is not null)
            {
                <p class="notice">@_presetMessage</p>
            }
        </section>

        <section class="panel">
            <h2>Rola</h2>
            @if (_data is null)
            {
                <p class="muted">Wczytywanie ról…</p>
            }
            else
            {
                <label class="field">
                    <span>Wybierz rolę, aby wypełnić token jej danymi</span>
                    <select value="@(_role?.Id ?? string.Empty)" @onchange="e => SelectRole(e.Value?.ToString())">
                        <option value="">— własny token —</option>
                        @foreach (var group in _data.AllRoles.GroupBy(r => r.Team).OrderBy(g => g.Key))
                        {
                            <optgroup label="@TeamText.Plural(group.Key)">
                                @foreach (var role in group.OrderBy(r => r.NamePl, StringComparer.CurrentCulture))
                                {
                                    <option value="@role.Id">@role.NamePl (@role.NameEn)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>

                @if (_role is not null)
                {
                    <div class="field">
                        <span>Token</span>
                        <div class="chips">
                            <button class="chip @(_settings.IsPlayer ? "chip--active" : null)" @onclick="() => ApplyRole(_role)">Postać</button>
                            @foreach (var reminder in _role.RemindersPl.Concat(_role.RemindersGlobalPl).Distinct())
                            {
                                <button class="chip @(!_settings.IsPlayer && _settings.Text == reminder ? "chip--active" : null)"
                                        @onclick="() => _settings.ApplyReminder(_role, reminder, LocalRoleIcons.IconUrl(_role.Id))">@reminder</button>
                            }
                        </div>
                    </div>
                }
            }
        </section>

        <section class="panel">
            <h2>Nazwa</h2>
            <div class="field-row">
                <label class="field">
                    <span>Typ tokena</span>
                    <select @bind="_settings.TokenType">
                        <option value="@TokenSettings.PlayerType">Postać</option>
                        <option value="@TokenSettings.ReminderType">Przypomnienie</option>
                    </select>
                </label>
                <label class="field">
                    <span>Czcionka</span>
                    <FontSelect @bind-Value="_settings.Font" />
                </label>
            </div>
            <label class="field">
                <span>Tekst</span>
                <textarea rows="2" @bind="_settings.Text" @bind:event="oninput"></textarea>
            </label>
            <Slider Label="Rozmiar" Min="10" Max="72" Step="1" @bind-Value="_settings.FontSize" />
            <Slider Label="Odstęp liter" Min="-5" Max="20" Step="0.5" @bind-Value="_settings.LetterSpacing" />
            <Slider Label="Położenie pionowe" Min="-1.5" Max="1" Step="0.05" @bind-Value="_settings.TextVertical" Format="0.00" />
        </section>

        @if (_settings.IsPlayer)
        {
            <section class="panel">
                <h2>Opis</h2>
                <label class="field">
                    <span>Tekst</span>
                    <textarea rows="3" @bind="_settings.Description" @bind:event="oninput"></textarea>
                </label>
                <label class="field">
                    <span>Czcionka</span>
                    <FontSelect @bind-Value="_settings.DescriptionFont" />
                </label>
                <Slider Label="Rozmiar" Min="8" Max="48" Step="1" @bind-Value="_settings.DescriptionFontSize" />
                <Slider Label="Przesunięcie pionowe" Min="-0.3" Max="0.6" Step="0.01" @bind-Value="_settings.DescriptionVertical" Format="0.00" />
            </section>
        }

        <section class="panel">
            <h2>Obrazek i tło</h2>
            <div class="field-row">
                <label class="button button--ghost button--file">
                    Wybierz obrazek…
                    <InputFile accept="image/png,image/jpeg,image/webp" OnChange="e => UploadAsync(e, url => _settings.ImageUrl = url)" />
                </label>
                <label class="button button--ghost button--file">
                    Wybierz tło…
                    <InputFile accept="image/png,image/jpeg,image/webp" OnChange="e => UploadAsync(e, url => _settings.BackgroundUrl = url)" />
                </label>
                <button class="button button--ghost" @onclick="ClearImages">Wyczyść</button>
            </div>
            @if (_uploadError is not null)
            {
                <p class="notice notice--error">@_uploadError</p>
            }
            <Slider Label="Wielkość obrazka" Min="0.2" Max="1.5" Step="0.05" @bind-Value="_settings.ImageScale" Format="0%" />
            <Slider Label="Przesunięcie pionowe" Min="-0.5" Max="0.5" Step="0.01" @bind-Value="_settings.ImageVertical" Format="0.00" />
            <Slider Label="Przesunięcie poziome" Min="-0.5" Max="0.5" Step="0.01" @bind-Value="_settings.ImageHorizontal" Format="0.00" />
        </section>

        @if (_settings.IsPlayer)
        {
            <section class="panel">
                <h2>Obwódka</h2>
                <div class="field-row">
                    <label class="field field--inline">
                        <input type="color" @bind="_settings.BorderColor" @bind:event="oninput" />
                        <span>Kolor</span>
                    </label>
                    <label class="field field--inline">
                        <input type="checkbox" checked="@(_settings.BorderColor2 is not null)" @onchange="ToggleSecondColor" />
                        <span>Druga połowa w innym kolorze</span>
                    </label>
                    @if (_settings.BorderColor2 is not null)
                    {
                        <label class="field field--inline">
                            <input type="color" @bind="_settings.BorderColor2" @bind:event="oninput" />
                            <span>Prawa połowa</span>
                        </label>
                    }
                </div>
                <Slider Label="Grubość" Min="0" Max="60" Step="1" @bind-Value="_settings.BorderThickness" />
            </section>

            <section class="panel">
                <h2>Liście</h2>
                <div class="checks">
                    <label><input type="checkbox" @bind="_settings.LeafFirstNight" /> Pierwsza noc</label>
                    <label><input type="checkbox" @bind="_settings.LeafOtherNights" /> Pozostałe noce</label>
                    <label><input type="checkbox" @bind="_settings.LeafSetup" /> Zmiana liczby ról</label>
                    <label><input type="checkbox" @bind="_settings.LeafReminders" /> Liczba znaczników przypomnień</label>
                </div>
                @if (_settings.LeafReminders)
                {
                    <Slider Label="Liczba znaczników" Min="1" Max="5" Step="1" @bind-Value="_settings.LeafReminderCount" />
                }
                <Slider Label="Rozmiar liści" Min="0.5" Max="1.5" Step="0.05" @bind-Value="_settings.LeafScale" Format="0%" />
            </section>
        }
    </div>

    <aside class="generator__preview">
        <section class="panel">
            <h2>Podgląd</h2>
            <canvas class="token-canvas" @ref="_canvas" width="@PreviewSize" height="@PreviewSize"></canvas>
            <Slider Label="@(_settings.IsPlayer ? "Średnica postaci (cm)" : "Średnica przypomnienia (cm)")" Min="1" Max="10" Step="0.01" @bind-Value="_settings.SizeCm" Format="0.00" />
            <div class="export">
                <label class="field">
                    <span>Średnica dokładnie (cm)</span>
                    <input type="number" min="1" max="10" step="0.01" value="@_settings.SizeCm.ToString("0.00", CultureInfo.InvariantCulture)" @onchange="SetSizeCm" />
                </label>
                <label class="field">
                    <span>Rozdzielczość druku</span>
                    <select @bind="_settings.Dpi">
                        <option value="150">150 DPI</option>
                        <option value="300">300 DPI</option>
                        <option value="600">600 DPI</option>
                    </select>
                </label>
                <button class="button" @onclick="DownloadAsync">Pobierz PNG</button>
            </div>
            <p class="muted small">PNG @_settings.ExportPixels × @_settings.ExportPixels px, przy druku @_settings.SizeCm.ToString("0.00") cm.</p>
            @if (_editing is null)
            {
                <button class="button button--wide" @onclick="AddToSheetAsync">Dodaj do arkusza</button>
            }
            else
            {
                <div class="editing-banner">
                    <p>Edytujesz token z arkusza. Zmiany widać na arkuszu na bieżąco.</p>
                    <div class="field-row">
                        <button class="button" @onclick="FinishEditingAsync">Zakończ edycję</button>
                        <button class="button button--ghost" @onclick="() => RemoveAsync(_editing)">Usuń z arkusza</button>
                    </div>
                </div>
            }
        </section>
    </aside>

    <section class="panel sheet-panel">
        <div class="sheet-toolbar">
            <h2>Arkusz A4 <span class="muted">(@_sheet.Count @TokenWord(_sheet.Count), stron: @SheetLayout.Pack(_sheet).Count)</span></h2>
            <div class="field-row">
                <button class="button" disabled="@(_sheet.Count == 0)" @onclick="PrintAsync">Drukuj / zapisz PDF</button>
                <button class="button button--ghost" disabled="@(_sheet.Count == 0)" @onclick="ClearSheetAsync">Wyczyść arkusz</button>
            </div>
        </div>
        @if (_sheetSaveFailed)
        {
            <p class="notice notice--error">Przeglądarka nie pozwoliła zapisać arkusza; po odświeżeniu strony zniknie.</p>
        }
        @if (_sheet.Count == 0)
        {
            <p class="muted">Arkusz jest pusty. Przygotuj token i kliknij „Dodaj do arkusza”. Tokeny są układane od największych, w rzeczywistym rozmiarze.</p>
        }
        else
        {
            <p class="muted small">Najedź na token, aby go edytować, zduplikować lub usunąć. Wydruk w skali 100% daje tokeny w ustawionych średnicach.</p>
            <TokenSheet Items="_sheet" Editing="_editing" OnEdit="EditItem" OnDuplicate="DuplicateAsync" OnRemove="RemoveAsync" />
        }
    </section>
</div>
