@page "/scripts/{Id}"
@inject GameDataClient Client
@inject ChangeSets Changes
@inject NavigationManager Nav
@using Grimoire_Studio.Printing

<div class="pinned fill-viewport">
<DataView Context="data">
    @if (data.FindScript(Id) is not { } script)
    {
        <PageTitle>Nie znaleziono – Grimoire Studio</PageTitle>
        <h1>Nie ma takiego skryptu</h1>
        <p>Skrypt <code>@Id</code> nie istnieje. <a href="scripts">Wróć do listy skryptów</a>.</p>
    }
    else
    {
        var roles = data.RolesOf(script);
        var jinxes = roles
            .SelectMany(r => data.JinxesFor(r.Id, script).Select(j => (Role: r, j.Other, j.Jinx)))
            .DistinctBy(x => x.Jinx)
            .ToList();

        <PageTitle>@script.Name – Grimoire Studio</PageTitle>

        <div class="pinned__top">
            <header class="script-header">
                <img class="script-header__icon" src="@GameDataClient.EditionIconUrl(script)" alt="" />
                <div>
                    <h1>@script.Name</h1>
                    <p class="muted">
                        @(script.IsOfficial ? "Skrypt oficjalny" : "Skrypt własny") · @roles.Count ról · <a href="roles?script=@script.Id">filtruj role</a>
                        @if (_isLocal)
                        {
                            <span class="local-badge">@(_hasOriginal ? (Changes.EditingWiki ? "zmieniony w wiki" : "zmieniony lokalnie") : (Changes.EditingWiki ? "nowy w wiki" : "tylko w tej przeglądarce"))</span>
                        }
                    </p>
                </div>
                <div class="script-actions">
                    <a class="button" href="scripts/@script.Id/edit">Edytuj</a>
                    <a class="button button--ghost" href="scripts/new?from=@script.Id">Duplikuj</a>
                    <button class="button button--ghost" @onclick="() => _printing = true">Drukuj / PDF</button>
                    <a class="button button--ghost" href="generator?script=@script.Id">Generuj tokeny</a>
                    <button class="button button--ghost" title="Plik JSON do script.bloodontheclocktower.com" @onclick="() => ExportAsync(script)">Eksport do Script Tool</button>
                    @if (_isLocal)
                    {
                        <button class="button button--ghost" @onclick="RemoveLocalAsync">@(_hasOriginal ? "Przywróć oryginał" : "Usuń skrypt")</button>
                    }
                </div>
            </header>
        </div>

        <div class="pinned__scroll">
            @foreach (var group in roles.GroupBy(r => r.Team).OrderBy(g => Teams.Get(g.Key).Order))
            {
                <section class="role-group">
                    <h2 class="team-heading team--@(group.Key)" style="@Teams.Style(group.Key)">@Teams.Plural(group.Key)</h2>
                    <ul class="sheet">
                        @foreach (var role in group)
                        {
                            <li class="sheet__row">
                                <a href="roles/@role.Id"><RoleIcon Role="role" /></a>
                                <div>
                                    <a class="sheet__name" href="roles/@role.Id">@role.NamePl</a> <WikiLink Role="role" />
                                    <p>@role.AbilityPl</p>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (jinxes.Count > 0)
            {
                <section class="role-group">
                    <h2>Zasady specjalne (jinxy)</h2>
                    <ul class="jinx-list">
                        @foreach (var (role, other, jinx) in jinxes)
                        {
                            <li>
                                <span class="jinx-pair"><RoleLink Role="role" /> + <RoleLink Role="other" /></span>
                                <p>@jinx.ReasonPl</p>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="role-group night-section">
                <h2>Kolejność nocy</h2>
                <div class="night-columns">
                    <NightOrderList Title="Pierwsza noc" Roles="data.NightOrder(script, firstNight: true)" FirstNight="true" />
                    <NightOrderList Title="Pozostałe noce" Roles="data.NightOrder(script, firstNight: false)" FirstNight="false" />
                </div>
            </section>
        </div>
    }
</DataView>
</div>

@if (_printing && _data?.FindScript(Id) is { } printed)
{
    <ScriptPrintDialog Script="printed" Data="_data" OnClose="() => _printing = false" />
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private bool _isLocal;
    private bool _hasOriginal;
    private bool _printing;
    private GameData? _data;

    protected override async Task OnParametersSetAsync()
    {
        _data = await Client.GetAsync(); // first: drops saved-but-unchanged scripts before the badge is decided
        _isLocal = await (await Changes.GetCurrentAsync()).Scripts.IsLocalAsync(Id);
        _hasOriginal = (await Client.GetBaseAsync()).FindScript(Id) is not null;
    }

    [Inject]
    private LocalStore Store { get; set; } = default!;

    private async Task ExportAsync(Script script)
    {
        var json = ScriptToolFormat.Export(script, await Client.GetAsync(), await Client.GetOriginalAsync());
        await Store.DownloadAsync($"{script.Id}.json", json);
    }

    private async Task RemoveLocalAsync()
    {
        await (await Changes.GetCurrentAsync()).Scripts.RemoveAsync(Id);

        // Reload the page so the original (or the script list) is shown.
        Nav.NavigateTo(_hasOriginal ? $"scripts/{Id}" : "scripts", forceLoad: true);
    }
}
