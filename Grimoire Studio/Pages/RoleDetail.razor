@page "/roles/{Id}"

<DataView Context="data">
    @if (data.FindRole(Id) is not { } role)
    {
        <PageTitle>Nie znaleziono – Grimoire Studio</PageTitle>
        <h1>Nie ma takiej roli</h1>
        <p>Rola <code>@Id</code> nie istnieje. <a href="roles">Wróć do listy ról</a>.</p>
    }
    else
    {
        var edition = role.Edition.Length > 0 ? data.FindScript(role.Edition) : null;
        var jinxes = data.JinxesFor(role.Id);
        var scripts = data.ScriptsWithRole(role.Id).ToList();

        <PageTitle>@role.NamePl – Grimoire Studio</PageTitle>

        <p class="breadcrumbs"><a href="roles">Role</a> / <a href="roles?team=@TeamText.Slug(role.Team)">@TeamText.Plural(role.Team)</a></p>

        <article class="role-detail team--@TeamText.Slug(role.Team)">
            <header class="role-detail__header">
                <RoleIcon Role="role" Size="lg" />
                <div>
                    <h1>@role.NamePl</h1>
                    <p class="role-detail__subtitle">
                        @role.NameEn · <TeamBadge Team="role.Team" />
                        @if (edition is not null)
                        {
                            <span> · <a href="scripts/@edition.Id">@edition.Name</a></span>
                        }
                    </p>
                </div>
            </header>

            <section class="panel">
                <h2>Zdolność</h2>
                <p class="ability">@role.AbilityPl</p>
                <p class="ability ability--en" lang="en">@role.AbilityEn</p>
                @if (role.Setup)
                {
                    <p class="note">Wpływa na przygotowanie gry.</p>
                }
            </section>

            <section class="panel">
                <h2>Noc</h2>
                <div class="night-columns">
                    <div class="night-info">
                        <h3>Pierwsza noc</h3>
                        @if (role.WakesFirstNight)
                        {
                            <span class="order">#@role.FirstNight</span>
                            <p>@role.FirstNightReminderPl</p>
                        }
                        else
                        {
                            <span class="muted">nie budzi się</span>
                        }
                    </div>
                    <div class="night-info">
                        <h3>Pozostałe noce</h3>
                        @if (role.WakesOtherNights)
                        {
                            <span class="order">#@role.OtherNight</span>
                            <p>@role.OtherNightReminderPl</p>
                        }
                        else
                        {
                            <span class="muted">nie budzi się</span>
                        }
                    </div>
                </div>
            </section>

            @if (role.RemindersPl.Count > 0 || role.RemindersGlobalPl.Count > 0)
            {
                <section class="panel">
                    <h2>Znaczniki przypomnień</h2>
                    <ul class="tags">
                        @foreach (var reminder in role.RemindersPl)
                        {
                            <li class="tag">@reminder</li>
                        }
                        @foreach (var reminder in role.RemindersGlobalPl)
                        {
                            <li class="tag tag--global" title="Znacznik globalny – dostępny zawsze, gdy rola jest na skrypcie">@reminder</li>
                        }
                    </ul>
                </section>
            }

            @if (jinxes.Count > 0)
            {
                <section class="panel">
                    <h2>Jinxy</h2>
                    <ul class="jinx-list">
                        @foreach (var (other, jinx) in jinxes)
                        {
                            <li>
                                <RoleLink Role="other" />
                                <p>@jinx.ReasonPl</p>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="panel">
                <h2>Skrypty</h2>
                @if (scripts.Count == 0)
                {
                    <p class="muted">Rola nie występuje w żadnym skrypcie.</p>
                }
                else
                {
                    <ul class="tags">
                        @foreach (var script in scripts)
                        {
                            <li><a class="tag tag--link" href="scripts/@script.Id">@script.Name</a></li>
                        }
                    </ul>
                }
            </section>
        </article>
    }
</DataView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;
}
