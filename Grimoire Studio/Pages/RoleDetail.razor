@page "/roles/{Id}"
@inject GameDataClient Client
@inject ChangeSets Changes
@inject NavigationManager Nav

<div class="pinned fill-viewport">
<DataView Context="data">
    @if (data.FindRole(Id) is not { } role)
    {
        <PageTitle>Nie znaleziono – Grimoire Studio</PageTitle>
        <h1>Nie ma takiej roli</h1>
        <p>Rola <code>@Id</code> nie istnieje. <a href="roles">Wróć do listy ról</a>.</p>
    }
    else
    {
        var edition = role.Edition.Length > 0 ? data.FindScript(role.Edition) : null;
        var jinxes = data.JinxesFor(role.Id);
        var scripts = data.ScriptsWithRole(role.Id).ToList();

        <PageTitle>@role.NamePl – Grimoire Studio</PageTitle>

        <div class="pinned__top team--@(role.Team)" style="@Teams.Style(role.Team)">
            <header class="role-detail__header">
                <RoleIcon Role="role" Size="lg" />
                <div>
                    <h1>@role.NamePl</h1>
                    <p class="role-detail__subtitle">
                        @role.NameEn · <TeamBadge Team="@role.Team" />
                        @if (edition is not null)
                        {
                            <span> · <a href="scripts/@edition.Id">@edition.Name</a></span>
                        }
                        @if (_isLocal)
                        {
                            <span class="local-badge">@(_hasOriginal ? (Changes.EditingWiki ? "zmieniona w wiki" : "zmieniona lokalnie") : (Changes.EditingWiki ? "nowa w wiki" : "tylko w tej przeglądarce"))</span>
                        }
                    </p>
                </div>
                <div class="script-actions">
                    <a class="button" href="roles/@role.Id/edit">Edytuj</a>
                    <a class="button button--ghost" href="roles/@role.Id/jinxes">Jinxy</a>
                    @if (_isLocal)
                    {
                        <button class="button button--ghost" @onclick="RemoveLocalAsync">@(_hasOriginal ? "Przywróć oryginał" : "Usuń rolę")</button>
                    }
                    <a class="button button--ghost" href="@WikiLink.Url(role)" target="_blank" rel="noopener noreferrer">Oficjalna wiki ↗</a>
                    <a class="button button--ghost" href="generator?role=@role.Id">Generuj token</a>
                </div>
            </header>
        </div>

        <div class="pinned__scroll">
            <article class="role-detail team--@role.Team @(jinxes.Count > 0 ? "role-detail--jinxes" : null)" style="@Teams.Style(role.Team)">
                <div class="role-detail__main">
                    <section class="panel">
                        <h2>Zdolność</h2>
                        <p class="ability">@role.AbilityPl</p>
                        <p class="ability ability--en" lang="en">@role.AbilityEn</p>
                        @if (role.Setup)
                        {
                            <p class="note">Wpływa na przygotowanie gry.</p>
                        }
                    </section>

                    <section class="panel">
                        <h2>Noc</h2>
                        <div class="night-columns">
                            <div class="night-info">
                                <h3>Pierwsza noc</h3>
                                @if (role.WakesFirstNight)
                                {
                                    <span class="order">#@role.FirstNight</span>
                                    <p>@role.FirstNightReminderPl</p>
                                }
                                else
                                {
                                    <span class="muted">nie budzi się</span>
                                }
                            </div>
                            <div class="night-info">
                                <h3>Pozostałe noce</h3>
                                @if (role.WakesOtherNights)
                                {
                                    <span class="order">#@role.OtherNight</span>
                                    <p>@role.OtherNightReminderPl</p>
                                }
                                else
                                {
                                    <span class="muted">nie budzi się</span>
                                }
                            </div>
                        </div>
                    </section>

                    @if (role.RemindersPl.Count > 0 || role.RemindersGlobalPl.Count > 0)
                    {
                        <section class="panel">
                            <h2>Znaczniki przypomnień</h2>
                            <ul class="tags">
                                @foreach (var reminder in role.RemindersPl)
                                {
                                    <li class="tag">@reminder</li>
                                }
                                @foreach (var reminder in role.RemindersGlobalPl)
                                {
                                    <li class="tag tag--global" title="Znacznik globalny – dostępny zawsze, gdy rola jest na skrypcie">@reminder</li>
                                }
                            </ul>
                        </section>
                    }

                    <section class="panel">
                        <h2>Skrypty</h2>
                        @if (scripts.Count == 0)
                        {
                            <p class="muted">Rola nie występuje w żadnym skrypcie.</p>
                        }
                        else
                        {
                            <ul class="tags">
                                @foreach (var script in scripts)
                                {
                                    <li><a class="tag tag--link" href="scripts/@script.Id">@script.Name</a></li>
                                }
                            </ul>
                        }
                    </section>
                </div>

                @if (jinxes.Count > 0)
                {
                    <section class="panel role-detail__jinxes">
                        <h2>Jinxy</h2>
                        <ul class="jinx-list">
                            @foreach (var (other, jinx) in jinxes)
                            {
                                <li>
                                    <RoleLink Role="other" />
                                    <p>@jinx.ReasonPl</p>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </article>
        </div>
    }
</DataView>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private bool _isLocal;
    private bool _hasOriginal;

    protected override async Task OnParametersSetAsync()
    {
        await Client.GetAsync(); // drops saved-but-unchanged roles before the badge is decided
        _isLocal = await (await Changes.GetCurrentAsync()).Roles.FindAsync(Id) is not null;
        _hasOriginal = (await Client.GetBaseAsync()).FindRole(Id) is not null;
    }

    private async Task RemoveLocalAsync()
    {
        await (await Changes.GetCurrentAsync()).Roles.RemoveAsync(Id);

        // Reload so the original role (or the role list) is shown with fresh data.
        Nav.NavigateTo(_hasOriginal ? $"roles/{Id}" : "roles", forceLoad: true);
    }
}
