@page "/admin"
@using System.IO.Compression
@inject GameDataClient Client
@inject ChangeSets ChangeSets
@inject Proposals Proposals
@inject NavigationManager Nav
@inject RepositoryPublisher Publisher
@implements IDisposable

@if (!_loaded || !ChangeSets.IsAdmin)
{
    @* Nothing is shown without the admin mode; the page sends the visitor to the home page. *@
    return;
}

<PageTitle>Panel administratora – Grimoire Studio</PageTitle>

<h1>Panel administratora</h1>

@if (_data is null || _wiki is null || _original is null || _wikiChanges is null)
{
    <p class="notice">Wczytywanie…</p>
}
else
{
    <section class="panel form">
        <h2>Edycja wiki</h2>
        <label class="field field--inline">
            <input type="checkbox" checked="@ChangeSets.EditingWiki" @onchange="e => SetEditingWikiAsync(e.Value is true)" />
            <span>Edytuję wiki bezpośrednio: edytory ról, skryptów, drużyn i jinxów zapisują do wiki zamiast do „Moich zmian”</span>
        </label>
        <div class="field-row">
            <button class="button button--ghost" @onclick="LeaveAdminAsync">Wyjdź z trybu administratora</button>
        </div>
    </section>

    @if (Publisher.IsConfigured)
    {
        <section class="panel form">
            <h2>Zapis do repozytorium</h2>
            @if (Publisher.AdminName is { } adminName)
            {
                <div class="field-row">
                    <span>Zalogowano jako <strong>@adminName</strong>: zmiany wiki wyślesz przyciskiem „Wyślij do repozytorium”.</span>
                    <button class="button button--ghost" @onclick="SignOutAsync">Wyloguj</button>
                </div>
                <DeploymentPanel @ref="_deployments" StatusChanged="status => _deployStatus = status" />
                @if (Publisher.IsOwner)
                {
                    <AdminsPanel />
                }
            }
            else
            {
                <div class="field-row">
                    <label class="field">
                        <span>Klucz administratora</span>
                        <input type="password" autocomplete="off" @bind="_adminKey" @bind:event="oninput" />
                    </label>
                    <button class="button" disabled="@(string.IsNullOrWhiteSpace(_adminKey) || _busy)" @onclick="SignInAsync">Zaloguj</button>
                </div>
                <p class="muted small">Klucz dostajesz od właściciela strony. Zostaje tylko w tej karcie przeglądarki.</p>
            }
        </section>
    }

    @if (_message is not null)
    {
        <p class="notice @(_messageIsError ? "notice--error" : null)">@_message</p>
    }

    <div class="title-row">
        <h2>Zmiany do wiki</h2>
        <div class="script-actions">
            <label class="button button--ghost button--file" title="Plik z eksportu „Moich zmian” od innej osoby">
                Dodaj zgłoszenie z pliku…
                <InputFile accept=".json,application/json" OnChange="ImportProposalAsync" />
            </label>
            <label class="button button--ghost button--file" title="Plik z eksportu zmian wiki: trafia od razu do zatwierdzonych">
                Importuj do wiki…
                <InputFile accept=".json,application/json" OnChange="ImportWikiAsync" />
            </label>
        </div>
    </div>

    <h3 class="admin-part">Czekają na decyzję (@_pending.Count)</h3>
    @if (_pending.Count == 0)
    {
        <p class="muted">Brak zgłoszeń. Zgłoszenia przychodzą ze strony „Moje zmiany” albo z plików eksportu.</p>
    }
    @foreach (var proposal in _pending)
    {
        var selected = _selection[proposal.Id];
        <section class="panel">
            <div class="form-list__head">
                <h3>@proposal.Author <span class="muted small">@proposal.CreatedAt.ToLocalTime().ToString("g")</span></h3>
                <div class="script-actions">
                    <button class="button" disabled="@(selected.Count == 0)" @onclick="() => ApproveAsync(proposal)">
                        Zatwierdź @(selected.Count == proposal.Changes.Count ? "wszystko" : $"zaznaczone ({selected.Count})")
                    </button>
                    <button class="button button--ghost" @onclick="() => RejectAsync(proposal)">Odrzuć</button>
                </div>
            </div>
            @if (proposal.Comment.Length > 0)
            {
                <p>@proposal.Comment</p>
            }
            @if (ProposalText.Outdated(proposal.Changes, _original.Version) is { } outdated)
            {
                <p class="notice notice--warning">@outdated</p>
            }
            <p class="muted small">Porównanie z obecną wiki. Odznacz pozycje, których nie chcesz przyjąć.</p>
            <ChangeSetView Changes="proposal.Changes" Base="_wiki" Data="_data" Selected="selected" SelectedChanged="() => { }" DetailsOpen="true" />
        </section>
    }

    <div class="title-row">
        <h3 class="admin-part">Zatwierdzone, do wysłania (@_wikiChanges.Count)</h3>
        <div class="script-actions">
            <button class="button button--ghost" disabled="@(_wikiChanges.Count == 0)" @onclick="DownloadDataFilesAsync"
                    title="Archiwum ZIP z plikami folderu data/, które zmienia wiki">
                Pobierz pliki danych (.zip)
            </button>
            <button class="button button--ghost" disabled="@(_wikiChanges.Count == 0)" @onclick="ExportWikiAsync">Eksportuj do pliku</button>
        </div>
    </div>
    <p class="muted small">
        Zatwierdzone zgłoszenia i zmiany wprowadzone bezpośrednio w wiki, względem danych strony. Są zapisane tylko w tej
        przeglądarce, dopóki ich nie wyślesz; plik eksportu to kopia zapasowa.
    </p>
    @if (_wikiChanges.Count > 0 && Unsent.Count > 0)
    {
        <p class="muted small">Ze zgłoszeń: @string.Join(", ", Unsent.Select(p => p.Author).Distinct())</p>
    }
    @if (ProposalText.Outdated(_wikiChanges, _original.Version) is { } wikiOutdated)
    {
        <p class="notice notice--warning">@wikiOutdated</p>
    }
    @if (Publisher.AdminName is not null && _wikiChanges.Count > 0)
    {
        <div class="field-row">
            <label class="field">
                <span>Opis zmian do historii repozytorium</span>
                <input type="text" @bind="_commitMessage" @bind:event="oninput" placeholder="np. Poprawione tłumaczenia jinxów" />
            </label>
            <button class="button" disabled="@_busy" @onclick="PublishAsync">@(_busy ? "Wysyłanie…" : "Wyślij do repozytorium")</button>
        </div>
    }
    <ChangeSetView Changes="_wikiChanges" Base="_original" Data="_data" OnRemove="RemoveWikiAsync" ShowJinxText="true">
        <p class="muted">Nic nie czeka na wysłanie.</p>
    </ChangeSetView>

    @if (History.Count > 0)
    {
        <h2>Historia</h2>
        <p class="muted small">
            @(_repoChanges is not null
                ? "Zmiany wysłane do repozytorium przez administratorów (widoczne po zalogowaniu na każdym komputerze) i zgłoszenia rozpatrzone w tej przeglądarce."
                : "Zgłoszenia rozpatrzone w tej przeglądarce; zmiany wysłane do repozytorium widać po zalogowaniu.")
            Historię jednej roli, skryptu lub jinxa pokazuje przycisk „Historia zmian” na ich stronach.
        </p>
        <ul class="change-list">
            @foreach (var entry in History)
            {
                <li>
                    @if (entry.Commit is { } commit)
                    {
                        <span class="change-list__what">
                            @commit.Title
                            @if (Deployment(commit) is { } deployed)
                            {
                                <span class="local-badge deployment--@deployed.Css">@deployed.Text</span>
                            }
                            else
                            {
                                <span class="local-badge">wysłane</span>
                            }
                            <span class="change-list__fields">
                                @commit.Date.ToLocalTime().ToString("g")
                                @if (commit.ApprovedBy is not null)
                                {
                                    <span> · zatwierdził: @commit.ApprovedBy</span>
                                }
                                @if (commit.Proposals is not null)
                                {
                                    <span> · zgłosili: @commit.Proposals</span>
                                }
                                · <a href="@commit.Url" target="_blank" rel="noopener noreferrer"><code>@commit.ShortSha</code></a>
                            </span>
                            @foreach (var proposal in entry.Proposals.Where(p => p.Comment.Length > 0))
                            {
                                <span class="change-list__fields">@proposal.Author: @proposal.Comment</span>
                            }
                        </span>
                        <CommitDetails Commit="commit" Data="_data" />
                    }
                    else
                    {
                        var proposal = entry.Proposals[0];
                        <span class="change-list__what">
                            @proposal.Author · @proposal.CreatedAt.ToLocalTime().ToString("g") · @ProposalText.Changes(proposal.Changes.Count)
                            <span class="local-badge">@ProposalText.Status(proposal)</span>
                            @if (proposal.PublishedIn is { } sha)
                            {
                                <span class="change-list__fields">w repozytorium: <code>@sha[..Math.Min(7, sha.Length)]</code></span>
                            }
                            @if (proposal.Comment.Length > 0)
                            {
                                <span class="change-list__fields">@proposal.Comment</span>
                            }
                        </span>
                        <button class="button button--ghost" @onclick="() => DeleteProposalAsync(proposal)">Usuń z historii</button>
                        <ProposalDetails Proposal="proposal" Base="proposal.DecidedBase(_original)" Data="_data" />
                    }
                </li>
            }
        </ul>
    }
}

@code {
    private const long MaxImportBytes = 50 * 1024 * 1024;

    [Inject]
    private LocalStore Store { get; set; } = default!;

    private bool _loaded;
    private GameData? _data;
    private GameData? _wiki;
    private GameData? _original;
    private LocalBackup? _wikiChanges;
    private List<Proposal> _pending = [];
    private List<Proposal> _decided = [];
    private List<WikiCommit>? _repoChanges;
    private readonly Dictionary<string, HashSet<string>> _selection = [];
    private string? _message;
    private string? _adminKey;
    private string? _commitMessage;
    private bool _busy;
    private DeploymentPanel? _deployments;
    private DeploymentStatus? _deployStatus;
    private bool _messageIsError;

    /// <summary>
    /// How a sent commit deployed: its own Build run when listed; a commit older than the last successful deployment is
    /// on the site with it, since each build deploys the whole repository. Null when unknown.
    /// </summary>
    private (string Text, string Css)? Deployment(WikiCommit commit)
    {
        if (_deployStatus is not { } status)
        {
            return null;
        }

        if (status.Runs.FirstOrDefault(r => r.Sha.StartsWith(commit.Sha, StringComparison.OrdinalIgnoreCase)) is { } run)
        {
            return run.IsRunning ? ("wdrażanie", "running") : run.Succeeded ? ("wdrożone", "done") : ($"wdrożenie: {run.StatusText}", "failed");
        }

        return status.Runs.LastOrDefault() is { IsRunning: false, Succeeded: true } last && commit.Date <= last.StartedAt
            ? ("wdrożone", "done")
            : null;
    }

    /// <summary>Approved proposals whose changes are still in the wiki, not sent yet.</summary>
    private List<Proposal> Unsent => _decided.Where(p => p.Status == ProposalStatus.Approved && p.PublishedIn is null).ToList();

    /// <summary>
    /// Repository commits with the proposals of this browser they took, and the decided proposals no listed commit
    /// took, newest first; approved proposals waiting in the wiki are shown with it instead.
    /// </summary>
    private List<HistoryEntry> History
    {
        get
        {
            var commits = _repoChanges ?? [];
            var taken = new HashSet<Proposal>();
            var entries = commits.Select(c =>
            {
                var proposals = _decided.Where(p => p.PublishedIn is { } sha && c.Sha.StartsWith(sha, StringComparison.OrdinalIgnoreCase)).ToList();
                taken.UnionWith(proposals);
                return new HistoryEntry(c.Date, c, proposals);
            }).ToList();

            var waiting = _wikiChanges is { Count: > 0 } ? Unsent.ToHashSet() : [];
            entries.AddRange(_decided
                .Where(p => !taken.Contains(p) && !waiting.Contains(p))
                .Select(p => new HistoryEntry(p.DecidedAt ?? p.CreatedAt, null, [p])));
            return entries.OrderByDescending(e => e.Date).ToList();
        }
    }

    private sealed record HistoryEntry(DateTimeOffset Date, WikiCommit? Commit, IReadOnlyList<Proposal> Proposals);

    protected override async Task OnInitializedAsync()
    {
        await ChangeSets.LoadAsync();
        ChangeSets.Changed += OnChangeSetsChanged;
        _loaded = true;

        // With ?admin in the address the layout is just turning the mode on; otherwise there is nothing to show here.
        if (!ChangeSets.IsAdmin && !ChangeSets.HasAdminParameter(Nav.Uri))
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        await Publisher.LoadAsync();
        await ReloadAsync();
    }

    private async void OnChangeSetsChanged()
    {
        if (!ChangeSets.IsAdmin && !ChangeSets.HasAdminParameter(Nav.Uri))
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        if (!ChangeSets.IsAdmin && !ChangeSets.HasAdminParameter(Nav.Uri))
        {
            return;
        }

        _original = await Client.GetOriginalAsync();
        _wiki = await Client.GetWikiAsync();
        _data = await Client.GetAsync();
        _wikiChanges = await ChangeSets.Wiki.GetAllAsync();

        var proposals = await Proposals.GetAllAsync();
        _pending = proposals.Where(p => p.Status == ProposalStatus.Pending).OrderBy(p => p.CreatedAt).ToList();
        _decided = proposals.Where(p => p.Status != ProposalStatus.Pending).OrderByDescending(p => p.DecidedAt).ToList();

        _repoChanges = null;
        if (Publisher.AdminName is not null)
        {
            try
            {
                _repoChanges = (await Publisher.GetChangesAsync()).ToList();
            }
            catch (PublishException ex)
            {
                Show($"Nie udało się wczytać zmian z repozytorium: {ex.Message}", error: true);
            }
        }

        // New proposals start with everything selected; the admin unticks what to leave out.
        foreach (var proposal in _pending.Where(p => !_selection.ContainsKey(p.Id)))
        {
            _selection[proposal.Id] = proposal.Changes.Keys().ToHashSet();
        }
    }

    private async Task LeaveAdminAsync()
    {
        await ChangeSets.SetAdminAsync(false);
        Nav.NavigateTo("");
    }

    private async Task SetEditingWikiAsync(bool on)
    {
        await ChangeSets.SetEditingWikiAsync(on);
        Show(on
            ? "Edytujesz wiki: zapisy w edytorach trafiają prosto do wiki."
            : "Edytory znowu zapisują do „Moich zmian”.");
    }

    private async Task ApproveAsync(Proposal proposal)
    {
        var accepted = proposal.Changes.Only(_selection[proposal.Id]);
        if (!await ChangeSets.Wiki.MergeAsync(accepted))
        {
            Show("Przeglądarka nie pozwoliła zapisać wiki (tryb prywatny lub brak miejsca).", error: true);
            return;
        }

        await DecideAsync(proposal with { ApprovedKeys = accepted.Keys().ToList() }, ProposalStatus.Approved, accepted.Count);
        Show($"Zatwierdzono {accepted.Count} z {proposal.Changes.Count} od: {proposal.Author}.");
    }

    private async Task RejectAsync(Proposal proposal)
    {
        await DecideAsync(proposal, ProposalStatus.Rejected, 0);
        Show($"Odrzucono zgłoszenie od: {proposal.Author}.");
    }

    private async Task DecideAsync(Proposal proposal, ProposalStatus status, int approved)
    {
        await Proposals.SaveAsync(proposal with
        {
            Status = status,
            DecidedAt = DateTimeOffset.Now,
            ApprovedCount = approved,
            Before = _wiki is null ? null : proposal.Changes.As(_wiki),
        });
        _selection.Remove(proposal.Id);
        await ReloadAsync();
    }

    private async Task DeleteProposalAsync(Proposal proposal)
    {
        await Proposals.RemoveAsync(proposal.Id);
        await ReloadAsync();
    }

    /// <summary>A "my changes" export from someone else becomes a pending proposal signed with the file name.</summary>
    private async Task ImportProposalAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            var changes = LocalChanges.Parse(await reader.ReadToEndAsync());
            await Proposals.SaveAsync(new Proposal
            {
                Id = Guid.NewGuid().ToString("N"),
                Author = Path.GetFileNameWithoutExtension(e.File.Name),
                Comment = "Zgłoszenie z pliku",
                CreatedAt = changes.ExportedAt == default ? DateTimeOffset.Now : changes.ExportedAt,
                Changes = changes,
            });
            Show($"Dodano zgłoszenie z pliku {e.File.Name} ({ProposalText.Changes(changes.Count)}).");
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            Show(ex.Message, error: true);
        }

        await ReloadAsync();
    }

    private async Task RemoveWikiAsync(string key)
    {
        await ChangeSets.Wiki.RemoveAsync(key);
        await ReloadAsync();
    }

    /// <summary>The data folder files the wiki changes, zipped under data/ so they unpack over the repository.</summary>
    private async Task DownloadDataFilesAsync()
    {
        IReadOnlyList<DataFile> files;
        try
        {
            files = RepositoryExport.ChangedFiles(await Client.GetOriginalAsync(), await ChangeSets.Wiki.GetAllAsync());
        }
        catch (InvalidDataException ex)
        {
            Show(ex.Message, error: true);
            return;
        }

        if (files.Count == 0)
        {
            Show("Wiki nie zmienia żadnego pliku danych.");
            return;
        }

        using var zip = new MemoryStream();
        using (var archive = new ZipArchive(zip, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (var file in files)
            {
                await using var entry = archive.CreateEntry($"data/{file.Path}").Open();
                await entry.WriteAsync(file.Content);
            }
        }

        await Store.DownloadAsync($"grimoire-studio-data-{DateTime.Now:yyyy-MM-dd}.zip", zip.ToArray(), "application/zip");
        Show($"Pobrano pliki danych: {string.Join(", ", files.Select(f => f.Path))}.");
    }

    private async Task SignInAsync()
    {
        _busy = true;
        try
        {
            await Publisher.SignInAsync(_adminKey ?? string.Empty);
            _adminKey = null;
            Show($"Zalogowano jako {Publisher.AdminName}.");
            await ReloadAsync();
        }
        catch (PublishException ex)
        {
            Show(ex.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Publisher.SignOutAsync();
        Show("Wylogowano.");
        await ReloadAsync();
    }

    /// <summary>
    /// Commits the files the wiki changes; the wiki changes are then cleared, as they are in the repository and reach the
    /// site with its next deployment.
    /// </summary>
    private async Task PublishAsync()
    {
        _busy = true;
        try
        {
            var original = await Client.GetOriginalAsync();
            var changes = await ChangeSets.Wiki.GetAllAsync();
            var files = RepositoryExport.ChangedFiles(original, changes);
            if (files.Count == 0)
            {
                Show("Wiki nie zmienia żadnego pliku danych.");
                return;
            }

            var message = string.IsNullOrWhiteSpace(_commitMessage)
                ? $"Zmiany wiki: {ProposalText.Changes(changes.Count)}"
                : _commitMessage.Trim();

            // Approved proposals not sent yet: their authors go into the commit, and they remember the commit.
            var sent = _decided.Where(p => p.Status == ProposalStatus.Approved && p.PublishedIn is null).ToList();
            var authors = sent.Select(p => p.Author).Distinct().ToList();
            if (authors.Count > 0)
            {
                message += $"\n\nZgłoszenia: {string.Join(", ", authors)}";
            }

            var result = await Publisher.PublishAsync(message, original.Version, files);
            foreach (var proposal in sent)
            {
                await Proposals.SaveAsync(proposal with { PublishedIn = result.Sha });
            }

            await ChangeSets.Wiki.ClearAsync();
            _commitMessage = null;
            if (result.Changed)
            {
                _deployments?.Watch(result.Sha);
            }

            Show(result.Changed
                ? $"Wysłano do repozytorium (commit {result.Sha[..7]}): {string.Join(", ", files.Select(f => f.Path))}. "
                    + "Strona pokaże zmiany po wdrożeniu (zwykle 2–3 minuty) – postęp widać w „Wdrażanie zmian wiki”."
                : "Repozytorium ma już te zmiany.");
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is PublishException or InvalidDataException)
        {
            Show(ex.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportWikiAsync() =>
        await Store.DownloadAsync($"grimoire-studio-wiki-{DateTime.Now:yyyy-MM-dd}.json", await ChangeSets.Wiki.ExportAsync());

    private async Task ImportWikiAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            var count = await ChangeSets.Wiki.ImportAsync(await reader.ReadToEndAsync(), replace: false);
            Show($"Dodano do wiki: {ProposalText.Changes(count)} z pliku {e.File.Name}.");
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            Show(ex.Message, error: true);
        }

        await ReloadAsync();
    }

    private void Show(string message, bool error = false)
    {
        _message = message;
        _messageIsError = error;
    }

    public void Dispose() => ChangeSets.Changed -= OnChangeSetsChanged;
}
