@page "/admin"
@using System.IO.Compression
@using System.Text.Json
@inject GameDataClient Client
@inject ChangeSets ChangeSets
@inject Proposals Proposals
@inject NavigationManager Nav
@inject RepositoryPublisher Publisher
@inject OutdatedCheck OutdatedCheck
@implements IDisposable

@if (!_loaded || !ChangeSets.IsAdmin)
{
    @* Nothing is shown without the admin mode; the page sends the visitor to the home page. *@
    return;
}

<PageTitle>Panel administratora – Grimoire Studio</PageTitle>

<h1>Panel administratora</h1>

@if (_data is null || _wiki is null || _original is null || _wikiChanges is null)
{
    <p class="notice">Wczytywanie…</p>
}
else
{
    @* Who is signed in, and the way out of the admin mode. *@
    <div class="admin-session">
        @if (!Publisher.IsConfigured)
        {
            <span class="muted">Zapis do repozytorium nie jest skonfigurowany: zmiany wiki wyeksportujesz do pliku.</span>
        }
        else if (Publisher.AdminName is { } adminName)
        {
            <span>Zalogowano jako <strong>@adminName</strong></span>
            <button class="button button--ghost" @onclick="SignOutAsync">Wyloguj</button>
        }
        else
        {
            <label class="field">
                <span>Klucz administratora</span>
                <input type="password" autocomplete="off" @bind="_adminKey" @bind:event="oninput" />
            </label>
            <button class="button" disabled="@(string.IsNullOrWhiteSpace(_adminKey) || _busy)" @onclick="SignInAsync">Zaloguj</button>
            <span class="muted small">Klucz dostajesz od właściciela strony. Zostaje tylko w tej karcie przeglądarki.</span>
        }
        <button class="button button--ghost admin-session__leave" @onclick="LeaveAdminAsync">Wyjdź z trybu administratora</button>
    </div>

    @if (_message is not null)
    {
        <p class="notice @(_messageIsError ? "notice--error" : null)">@_message</p>
    }

    <div class="title-row">
        <h2>Zmiany do wiki</h2>
        <div class="script-actions">
            <label class="button button--ghost button--file" title="Plik z eksportu „Moich zmian” od innej osoby">
                Dodaj zgłoszenie z pliku…
                <InputFile accept=".json,application/json" OnChange="ImportProposalAsync" />
            </label>
            <label class="button button--ghost button--file" title="Plik z eksportu zmian wiki: trafia od razu do zatwierdzonych">
                Importuj do wiki…
                <InputFile accept=".json,application/json" OnChange="ImportWikiAsync" />
            </label>
        </div>
    </div>

    <section class="panel admin-section">
        <h3 class="admin-part">
            Czekają na akceptację (@ProposalText.Changes(_pending.Sum(p => p.UndecidedKeys().Count)))
            @if (_pending.Count > 0)
            {
                <span class="muted small">zgłoszenia: @_pending.Count</span>
            }
        </h3>
        @if (_pending.Count == 0)
        {
            <p class="muted">Brak zgłoszeń. Zgłoszenia przychodzą ze strony „Moje zmiany” albo z plików eksportu.</p>
        }
        @if (Proposals.OnServer && Publisher.AdminName is null)
        {
            <p class="notice notice--warning">Zgłoszenia wysłane przez innych zobaczysz po zalogowaniu kluczem administratora.</p>
        }
        @foreach (var proposal in _pending)
        {
            var waiting = proposal.UndecidedKeys();
            var selected = _selection[proposal.Id];
            var which = selected.Count == waiting.Count ? "wszystko" : $"zaznaczone ({selected.Count})";
            <section class="panel">
                <div class="form-list__head">
                    <h3>@proposal.Author <span class="muted small">@proposal.CreatedAt.ToLocalTime().ToString("g") · @ProposalText.Changes(waiting.Count)</span></h3>
                    <div class="script-actions">
                        <button class="button" disabled="@(selected.Count == 0)" @onclick="() => DecideAsync(proposal, approve: true)">Zatwierdź @which</button>
                        <button class="button button--ghost" disabled="@(selected.Count == 0)" @onclick="() => DecideAsync(proposal, approve: false)">Odrzuć @which</button>
                    </div>
                </div>
                @if (proposal.Comment.Length > 0)
                {
                    <p>@proposal.Comment</p>
                }
                @if (_outdated.GetValueOrDefault(proposal.Id) is { } outdated)
                {
                    <p class="notice notice--warning">@outdated</p>
                }
                @if (proposal.ApprovedKeys.Count + proposal.RejectedKeys.Count > 0)
                {
                    <p class="muted small">
                        Już rozpatrzone: zatwierdzone @proposal.ApprovedKeys.Count, odrzucone @proposal.RejectedKeys.Count.
                        Poniżej tylko pozycje, które jeszcze czekają.
                    </p>
                }
                <p class="muted small">Porównanie z obecną wiki. Zaznacz pozycje, które zatwierdzasz albo odrzucasz; pozostałe poczekają.</p>
                <ChangeSetView Changes="proposal.Changes.Only(waiting)" Base="_wiki" Data="_data" Selected="selected" SelectedChanged="() => { }" DetailsOpen="true">
                    <Actions Context="key">
                        <button class="button" @onclick="() => DecideAsync(proposal, approve: true, [key])">Zatwierdź</button>
                        <button class="button button--ghost" @onclick="() => DecideAsync(proposal, approve: false, [key])">Odrzuć</button>
                    </Actions>
                </ChangeSetView>
            </section>
        }
    </section>

    <section class="panel admin-section">
        <div class="title-row">
            <h3 class="admin-part">Zatwierdzone, do wysłania (@_wikiChanges.Count)</h3>
            <div class="script-actions">
                <button class="button button--ghost" disabled="@(_wikiChanges.Count == 0)" @onclick="DownloadDataFilesAsync"
                        title="Archiwum ZIP z plikami folderu data/, które zmienia wiki">
                    Pobierz pliki danych (.zip)
                </button>
                <button class="button button--ghost" disabled="@(_wikiChanges.Count == 0)" @onclick="ExportWikiAsync">Eksportuj do pliku</button>
            </div>
        </div>
        <p class="muted small">
            Zatwierdzone zgłoszenia i zmiany wprowadzone bezpośrednio w wiki, względem danych strony; przy każdej pozycji
            widać, skąd pochodzi. Są zapisane tylko w tej przeglądarce, dopóki ich nie wyślesz; plik eksportu to kopia zapasowa.
        </p>
        <label class="field field--inline">
            <input type="checkbox" checked="@ChangeSets.EditingWiki" @onchange="e => SetEditingWikiAsync(e.Value is true)" />
            <span>Edytuję wiki bezpośrednio: edytory ról, skryptów, drużyn i jinxów zapisują tutaj zamiast do „Moich zmian”</span>
        </label>
        @if (_outdated.GetValueOrDefault(WikiKey) is { } wikiOutdated)
        {
            <p class="notice notice--warning">@wikiOutdated</p>
        }
        @if (_wikiChanges.Count > 0)
        {
            @* Ticked items go back where they came from: a proposal's back to waiting, a direct wiki edit away. *@
            <div class="field-row wiki-undo">
                <button class="button button--ghost" disabled="@(_wikiSelection.Count == _wikiChanges.Count)"
                        @onclick="() => { _wikiSelection = _wikiChanges.Keys().ToHashSet(); _confirmUndo = false; }">Zaznacz wszystkie</button>
                <button class="button button--ghost" disabled="@(_wikiSelection.Count == 0)"
                        @onclick="() => { _wikiSelection.Clear(); _confirmUndo = false; }">Odznacz wszystkie</button>
                <button class="button" disabled="@(_wikiSelection.Count == 0 || _busy)"
                        title="Zmiany ze zgłoszeń wracają do „Czekają na akceptację”; zmiany wprowadzone bezpośrednio w wiki są usuwane"
                        @onclick="UndoSelectedAsync">
                    @(_confirmUndo ? $"Na pewno cofnąć: {ProposalText.Changes(_wikiSelection.Count)}?" : $"Cofnij zaznaczone ({_wikiSelection.Count})")
                </button>
            </div>
        }
        <ChangeSetView Changes="_wikiChanges" Base="_original" BaseIsDataFolder="true" Data="_data" OnRemove="RemoveWikiAsync" ShowJinxText="true" Origins="Origins"
                       Selected="_wikiSelection" SelectedChanged="() => _confirmUndo = false">
            <p class="muted">Nic nie czeka na wysłanie.</p>
        </ChangeSetView>
        @if (Publisher.AdminName is not null && _wikiChanges.Count > 0)
        {
            <div class="field-row">
                <label class="field">
                    <span>Opis zmian do historii repozytorium</span>
                    <input type="text" @bind="_commitMessage" @bind:event="oninput" placeholder="np. Poprawione tłumaczenia jinxów" />
                </label>
                <button class="button" disabled="@(_busy || _conflicts is { Count: > 0 })" @onclick="PublishAsync">@(_busy ? _publishProgress ?? "Wysyłanie…" : "Wyślij do repozytorium")</button>
            </div>
        }
        @if (_conflicts is { Count: > 0 } conflicts)
        {
            <section class="panel">
                <h3>Konflikty z repozytorium (@conflicts.Count)</h3>
                <p class="muted small">
                    Od czasu, gdy te zmiany powstały, ktoś zmienił w repozytorium te same pozycje. Zdecyduj przy każdej, która
                    wersja zostaje; potem wyślij zmiany ponownie.
                </p>
                <ul class="change-list">
                    @foreach (var conflict in conflicts)
                    {
                        <li>
                            <span class="change-list__what"><strong>@conflict.Label</strong></span>
                            <ItemDiffTable Rows="conflict.Theirs" Summary="Zmiana w repozytorium" Open="true" />
                            <ItemDiffTable Rows="conflict.Mine" Summary="Twoja zmiana" Open="true" />
                            <div class="script-actions">
                                <button class="button" @onclick="() => KeepMine(conflict)">Zostaw moją</button>
                                <button class="button button--ghost" @onclick="() => TakeTheirsAsync(conflict)">Weź z repozytorium</button>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    </section>

    @if (History.Count > 0 || _sentSha is not null)
    {
        <section class="panel admin-section">
            <div class="title-row">
                <h2>Historia</h2>
                <div class="script-actions">
                    <DeploymentPanel Sent="@_sentSha" StatusChanged="status => _deployStatus = status" />
                </div>
            </div>
            <p class="muted small">
                Zmiany wysłane do repozytorium, czyli te, które są (albo za chwilę będą) w wiki. Wysłany commit można cofnąć
                w „Pokaż zmiany”. Historię jednej roli, skryptu lub jinxa pokazuje przycisk „Historia zmian” na ich stronach.
            </p>
            @if (_deployStatus?.AnyRunning == true)
            {
                <p class="muted small">
                    Trwa wdrażanie; stan sprawdzam co @DeploymentPanel.PollSeconds s. Po jego końcu zmiany będą widoczne dla
                    wszystkich, a ta karta pokaże je po odświeżeniu strony (F5).
                </p>
            }
            <ul class="change-list">
                @foreach (var (commit, proposals) in History)
                {
                    <li>
                        <span class="change-list__what">
                            @commit.Title
                            @if (Deployment(commit) is { } deployed)
                            {
                                <span class="local-badge deployment--@deployed.Css">@deployed.Text</span>
                            }
                            else
                            {
                                <span class="local-badge">wysłane</span>
                            }
                            <span class="change-list__fields">
                                @commit.Date.ToLocalTime().ToString("g")
                                @if (commit.ApprovedBy is not null)
                                {
                                    <span> · zatwierdził: @commit.ApprovedBy</span>
                                }
                                @if (commit.Proposals is not null)
                                {
                                    <span> · zgłosili: @commit.Proposals</span>
                                }
                                · <a href="@commit.Url" target="_blank" rel="noopener noreferrer"><code>@commit.ShortSha</code></a>
                            </span>
                            @foreach (var proposal in proposals.Where(p => p.Comment.Length > 0))
                            {
                                <span class="change-list__fields">@proposal.Author: @proposal.Comment</span>
                            }
                        </span>
                        <CommitDetails Commit="commit" Data="_data" Wiki="_wiki" OnRevert="changes => RevertAsync(commit, changes)" />
                    </li>
                }
            </ul>
        </section>
    }
    else if (Publisher.IsConfigured && Publisher.AdminName is null)
    {
        <p class="muted small">Historię zmian wysłanych do repozytorium zobaczysz po zalogowaniu.</p>
    }

    @if (Publisher.AdminName is not null && Publisher.IsOwner)
    {
        <details class="panel admin-section admin-admins">
            <summary><h2>Administratorzy</h2></summary>
            <AdminsPanel />
        </details>
    }
}

@code {
    private const long MaxImportBytes = 50 * 1024 * 1024;

    [Inject]
    private LocalStore Store { get; set; } = default!;

    private bool _loaded;
    private GameData? _data;
    private GameData? _wiki;
    private GameData? _original;

    /// <summary>Warnings about items changed in the wiki since the changes were made, by proposal id or <see cref="WikiKey"/>.</summary>
    private readonly Dictionary<string, string> _outdated = [];
    private const string WikiKey = "wiki";
    private LocalBackup? _wikiChanges;
    private List<Proposal> _pending = [];
    private List<Proposal> _decided = [];
    private List<WikiCommit>? _repoChanges;
    private readonly Dictionary<string, HashSet<string>> _selection = [];
    private string? _message;
    private string? _adminKey;
    private string? _commitMessage;
    private bool _busy;

    /// <summary>How far the upload of a big send got, shown on its button.</summary>
    private string? _publishProgress;

    /// <summary>Last commit sent from this page; the deployment panel follows it.</summary>
    private string? _sentSha;
    private DeploymentStatus? _deployStatus;
    private bool _messageIsError;

    /// <summary>Items changed both here and in the repository, found when sending; null before the check.</summary>
    private List<Conflict>? _conflicts;

    /// <summary>Keys of conflicting items where the admin chose to keep the wiki's version.</summary>
    private readonly HashSet<string> _keepMine = [];

    private sealed record Conflict(
        string Key,
        string Label,
        IReadOnlyList<(string Label, string Before, string After)> Theirs,
        IReadOnlyList<(string Label, string Before, string After)> Mine);

    /// <summary>
    /// How a sent commit deployed: its own Build run when listed; a commit older than the last successful deployment is
    /// on the site with it, since each build deploys the whole repository. Null when unknown.
    /// </summary>
    private (string Text, string Css)? Deployment(WikiCommit commit)
    {
        if (_deployStatus is not { } status)
        {
            return null;
        }

        if (status.Runs.FirstOrDefault(r => r.Sha.StartsWith(commit.Sha, StringComparison.OrdinalIgnoreCase)) is { } run)
        {
            return run.IsRunning ? ("wdrażanie", "running") : run.Succeeded ? ("wdrożone", "done") : ($"wdrożenie: {run.StatusText}", "failed");
        }

        return status.Runs.LastOrDefault() is { IsRunning: false, Succeeded: true } last && commit.Date <= last.StartedAt
            ? ("wdrożone", "done")
            : null;
    }

    /// <summary>Approved proposals whose changes are still in the wiki, not sent yet.</summary>
    private List<Proposal> Unsent => _pending.Concat(_decided).Where(p => p.IsUnsent).ToList();

    /// <summary>Where each wiki change came from: the authors of the approved proposals that hold it.</summary>
    private Dictionary<string, string> Origins =>
        Unsent.SelectMany(p => p.ApprovedKeys.Select(key => (Key: key, p.Author)))
            .GroupBy(x => x.Key)
            .ToDictionary(g => g.Key, g => "zgłoszenie: " + string.Join(", ", g.Select(x => x.Author).Distinct()));

    /// <summary>
    /// Wiki changes that reached the repository, newest first, each with the proposals it took (for their comments).
    /// Decided proposals that were not sent are not history of the wiki.
    /// </summary>
    private List<HistoryEntry> History =>
        (_repoChanges ?? [])
            .Select(c => new HistoryEntry(c, _pending.Concat(_decided)
                .Where(p => p.PublishedIn is { } sha && c.Sha.StartsWith(sha, StringComparison.OrdinalIgnoreCase))
                .ToList()))
            .ToList();

    private sealed record HistoryEntry(WikiCommit Commit, IReadOnlyList<Proposal> Proposals);

    protected override async Task OnInitializedAsync()
    {
        await ChangeSets.LoadAsync();
        ChangeSets.Changed += OnChangeSetsChanged;
        _loaded = true;

        // With ?admin in the address the layout is just turning the mode on; otherwise there is nothing to show here.
        if (!ChangeSets.IsAdmin && !ChangeSets.HasAdminParameter(Nav.Uri))
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        await Publisher.LoadAsync();
        await ReloadAsync();
    }

    private async void OnChangeSetsChanged()
    {
        if (!ChangeSets.IsAdmin && !ChangeSets.HasAdminParameter(Nav.Uri))
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        if (!ChangeSets.IsAdmin && !ChangeSets.HasAdminParameter(Nav.Uri))
        {
            return;
        }

        _original = await Client.GetOriginalAsync();
        _wiki = await Client.GetWikiAsync();
        _data = await Client.GetAsync();
        _wikiChanges = await ChangeSets.Wiki.GetAllAsync();

        IReadOnlyList<Proposal> proposals;
        try
        {
            proposals = await Proposals.GetForAdminAsync();
        }
        catch (PublishException ex)
        {
            proposals = await Proposals.GetAllAsync();
            Show($"Nie udało się wczytać zgłoszeń z serwera: {ex.Message}", error: true);
        }

        _pending = proposals.Where(p => p.Status == ProposalStatus.Pending).OrderBy(p => p.CreatedAt).ToList();
        _decided = proposals.Where(p => p.Status != ProposalStatus.Pending).OrderByDescending(p => p.DecidedAt).ToList();

        _repoChanges = null;
        if (Publisher.AdminName is not null)
        {
            try
            {
                _repoChanges = (await Publisher.GetChangesAsync()).ToList();
            }
            catch (PublishException ex)
            {
                Show($"Nie udało się wczytać zmian z repozytorium: {ex.Message}", error: true);
            }
        }

        _outdated.Clear();
        if (await OutdatedCheck.WarningAsync(_wikiChanges, _original) is { } wikiOutdated)
        {
            _outdated[WikiKey] = wikiOutdated;
        }

        foreach (var proposal in _pending)
        {
            if (await OutdatedCheck.WarningAsync(proposal.Changes.Only(proposal.UndecidedKeys()), _original) is { } outdated)
            {
                _outdated[proposal.Id] = outdated;
            }
        }

        // New proposals start with every waiting item selected; the admin unticks what to leave for later.
        foreach (var proposal in _pending.Where(p => !_selection.ContainsKey(p.Id)))
        {
            _selection[proposal.Id] = proposal.UndecidedKeys().ToHashSet();
        }
    }

    private async Task LeaveAdminAsync()
    {
        await ChangeSets.SetAdminAsync(false);
        Nav.NavigateTo("");
    }

    private async Task SetEditingWikiAsync(bool on)
    {
        await ChangeSets.SetEditingWikiAsync(on);
        Show(on
            ? "Edytujesz wiki: zapisy w edytorach trafiają prosto do wiki."
            : "Edytory znowu zapisują do „Moich zmian”.");
    }

    /// <summary>
    /// Approves (into the wiki) or rejects the given items of a proposal, by default the ticked ones; the others keep
    /// waiting, and the proposal is decided once none is left.
    /// </summary>
    private async Task DecideAsync(Proposal proposal, bool approve, IEnumerable<string>? only = null)
    {
        var keys = (only ?? _selection[proposal.Id]).ToHashSet();
        var items = proposal.Changes.Only(keys);

        // The items as the wiki has them before the decision, for the history.
        var decided = proposal.Decide(keys, approve, _wiki is null ? new LocalBackup() : items.As(_wiki));
        if (approve && !await ChangeSets.Wiki.MergeAsync(items))
        {
            Show("Przeglądarka nie pozwoliła zapisać wiki (tryb prywatny lub brak miejsca).", error: true);
            return;
        }

        try
        {
            await Proposals.UpdateAsync(decided);
        }
        catch (PublishException ex)
        {
            // The proposal stays as it was; approving the same items again merges the same changes.
            Show($"Nie udało się zapisać decyzji na serwerze: {ex.Message}", error: true);
            return;
        }

        var left = decided.UndecidedKeys().Count;
        Show($"{(approve ? "Zatwierdzono" : "Odrzucono")}: {ProposalText.Changes(keys.Count)} ({proposal.Author})."
            + (left > 0 ? $" Czeka jeszcze: {left}." : string.Empty));
        if (only is null)
        {
            _selection.Remove(proposal.Id);
        }
        else
        {
            // A single item's decision keeps the ticks of the others.
            _selection[proposal.Id].ExceptWith(keys);
        }

        await ReloadAsync();
    }

    /// <summary>A "my changes" export from someone else becomes a pending proposal signed with the file name.</summary>
    private async Task ImportProposalAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            var changes = LocalChanges.Parse(await reader.ReadToEndAsync());
            var author = Path.GetFileNameWithoutExtension(e.File.Name);
            await Proposals.UpdateAsync(new Proposal
            {
                Id = Guid.NewGuid().ToString("N"),
                Author = author.Length > 40 ? author[..40] : author,
                Comment = "Zgłoszenie z pliku",
                CreatedAt = changes.ExportedAt == default ? DateTimeOffset.Now : changes.ExportedAt,
                Changes = changes,
            });
            Show($"Dodano zgłoszenie z pliku {e.File.Name} ({ProposalText.Changes(changes.Count)}).");
        }
        catch (Exception ex) when (ex is FormatException or IOException or PublishException)
        {
            Show(ex.Message, error: true);
        }

        await ReloadAsync();
    }

    /// <summary>
    /// Takes an item out of the wiki changes; one that came from a proposal goes back to waiting for a decision.
    /// </summary>
    private Task RemoveWikiAsync(string key) => UndoWikiAsync([key]);

    /// <summary>Ticked items of "Zatwierdzone, do wysłania"; none at first.</summary>
    private HashSet<string> _wikiSelection = [];

    /// <summary>The first click on "Cofnij zaznaczone" asks to confirm.</summary>
    private bool _confirmUndo;

    private async Task UndoSelectedAsync()
    {
        if (!_confirmUndo)
        {
            _confirmUndo = true;
            return;
        }

        _confirmUndo = false;
        _busy = true;
        try
        {
            await UndoWikiAsync(_wikiSelection.ToList());
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Takes items out of the wiki changes, back to where they came from: one approved from a proposal waits for a
    /// decision again, a direct wiki edit is gone.
    /// </summary>
    private async Task UndoWikiAsync(IReadOnlyCollection<string> keys)
    {
        foreach (var key in keys)
        {
            await ChangeSets.Wiki.RemoveAsync(key);
        }

        var reopened = 0;
        var failed = new List<string>();
        foreach (var proposal in Unsent.Where(p => p.ApprovedKeys.Any(keys.Contains)))
        {
            var back = keys.Where(proposal.ApprovedKeys.Contains).ToList();
            try
            {
                await Proposals.UpdateAsync(back.Aggregate(proposal, (p, key) => p.Reopen(key)));
                _selection.Remove(proposal.Id);
                reopened += back.Count;
            }
            catch (PublishException ex)
            {
                failed.Add($"{proposal.Author}: {ex.Message}");
            }
        }

        _wikiSelection.ExceptWith(keys);
        var removed = keys.Count - reopened - failed.Count;
        if (failed.Count > 0)
        {
            Show($"Wycofano z wiki, ale nie udało się przywrócić zgłoszeń na serwerze ({string.Join("; ", failed)}).", error: true);
        }
        else
        {
            Show(string.Join(" ", new[]
            {
                reopened > 0 ? $"Wraca do „Czekają na akceptację”: {ProposalText.Changes(reopened)}." : null,
                removed > 0 ? $"Usunięto zmiany wprowadzone bezpośrednio w wiki: {ProposalText.Changes(removed)}." : null,
            }.OfType<string>()));
        }

        await ReloadAsync();
    }

    /// <summary>The data folder files the wiki changes, zipped under data/ so they unpack over the repository.</summary>
    private async Task DownloadDataFilesAsync()
    {
        IReadOnlyList<DataFile> files;
        try
        {
            files = RepositoryExport.ChangedFiles(await Client.GetOriginalAsync(), await ChangeSets.Wiki.GetAllAsync());
        }
        catch (InvalidDataException ex)
        {
            Show(ex.Message, error: true);
            return;
        }

        if (files.Count == 0)
        {
            Show("Wiki nie zmienia żadnego pliku danych.");
            return;
        }

        using var zip = new MemoryStream();
        using (var archive = new ZipArchive(zip, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (var file in files.Where(f => !f.Deleted))
            {
                await using var entry = archive.CreateEntry($"data/{file.Path}").Open();
                await entry.WriteAsync(file.Content);
            }
        }

        await Store.DownloadAsync($"grimoire-studio-data-{DateTime.Now:yyyy-MM-dd}.zip", zip.ToArray(), "application/zip");
        Show($"Pobrano pliki danych: {string.Join(", ", files.Select(f => f.Path))}.");
    }

    private async Task SignInAsync()
    {
        _busy = true;
        try
        {
            await Publisher.SignInAsync(_adminKey ?? string.Empty);
            _adminKey = null;
            Show($"Zalogowano jako {Publisher.AdminName}.");
            await ReloadAsync();
        }
        catch (PublishException ex)
        {
            Show(ex.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Publisher.SignOutAsync();
        Show("Wylogowano.");
        await ReloadAsync();
    }

    /// <summary>
    /// Commits the files the wiki changes; the wiki changes are then cleared, as they are in the repository and reach the
    /// site with its next deployment. When the repository moved on since the site was built, the changes go on top of
    /// its current data, unless someone changed the same items there: those are shown as conflicts first.
    /// </summary>
    private async Task PublishAsync()
    {
        _busy = true;
        try
        {
            var original = await Client.GetOriginalAsync();
            var changes = await ChangeSets.Wiki.GetAllAsync();
            var target = await Publisher.GetDataAsync(original);
            if (!SameVersion(target.Version, original.Version))
            {
                var made = changes.BaseVersion.Length > 0 && !SameVersion(changes.BaseVersion, original.Version)
                    ? await DataAtAsync(changes.BaseVersion) ?? original
                    : original;
                _conflicts = ItemConflicts.Find(made, target, changes)
                    .Where(key => !_keepMine.Contains(key))
                    .Select(key => ConflictOf(key, made, target, changes))
                    .ToList();
                if (_conflicts.Count > 0)
                {
                    Show($"Nie wysłano: w repozytorium zmieniono te same pozycje ({_conflicts.Count}). Rozstrzygnij konflikty poniżej.", error: true);
                    return;
                }
            }

            var files = RepositoryExport.ChangedFiles(target, changes);
            if (files.Count == 0)
            {
                Show("Wiki nie zmienia żadnego pliku danych.");
                return;
            }

            var message = string.IsNullOrWhiteSpace(_commitMessage)
                ? $"Zmiany wiki: {ProposalText.Changes(changes.Count)}"
                : _commitMessage.Trim();

            // Approved proposals not sent yet: their authors go into the commit, and they remember the commit.
            var sent = Unsent;
            var authors = sent.Select(p => p.Author).Distinct().ToList();
            if (authors.Count > 0)
            {
                message += $"\n\nZgłoszenia: {string.Join(", ", authors)}";
            }

            var result = await Publisher.PublishAsync(message, target.Version, files, (done, total) =>
            {
                _publishProgress = $"Wysyłanie plików {done}/{total}…";
                StateHasChanged();
            });
            foreach (var proposal in sent)
            {
                try
                {
                    await Proposals.UpdateAsync(proposal with { PublishedIn = result.Sha });
                }
                catch (PublishException)
                {
                    // The commit is made; the proposal only misses the link to it in the history.
                }
            }

            await ChangeSets.Wiki.ClearAsync();
            _commitMessage = null;
            _conflicts = null;
            _keepMine.Clear();
            if (result.Changed)
            {
                _sentSha = result.Sha;
            }

            Show(result.Changed
                ? $"Wysłano do repozytorium (commit {result.Sha[..7]}): {string.Join(", ", files.Select(f => f.Path))}. "
                    + "Strona pokaże zmiany po wdrożeniu (zwykle 2–3 minuty) – postęp widać w „Historii”."
                : "Repozytorium ma już te zmiany.");
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is PublishException or InvalidDataException)
        {
            Show(ex.Message, error: true);
        }
        finally
        {
            _busy = false;
            _publishProgress = null;
        }
    }

    /// <summary>The site's data version (a short commit id) and the repository's commit id name the same commit.</summary>
    private static bool SameVersion(string a, string b) =>
        a.Length > 0 && b.Length > 0 && (a.StartsWith(b, StringComparison.OrdinalIgnoreCase) || b.StartsWith(a, StringComparison.OrdinalIgnoreCase));

    /// <summary>The repository's data at a version, or null when it is not a commit (e.g. a local build).</summary>
    private async Task<GameData?> DataAtAsync(string version)
    {
        try
        {
            return await Publisher.GetDataAsync(_original!, version);
        }
        catch (PublishException)
        {
            return null;
        }
    }

    private Conflict ConflictOf(string key, GameData made, GameData now, LocalBackup changes)
    {
        var (kind, id) = ItemLabel.Split(key);
        JsonElement? Element(GameData data) => ItemConflicts.Json(data, key) is { } json ? JsonDocument.Parse(json).RootElement : null;
        var before = Element(made);
        return new Conflict(
            key,
            ItemLabel.Of(_data!, kind, id, before),
            ItemDiff.Changes(before, Element(now)),
            ItemDiff.Changes(before, Element(changes.ApplyTo(made))));
    }

    private void KeepMine(Conflict conflict)
    {
        _keepMine.Add(conflict.Key);
        _conflicts!.Remove(conflict);
        if (_conflicts.Count == 0)
        {
            Show("Konflikty rozstrzygnięte. Wyślij zmiany ponownie.");
        }
    }

    private async Task TakeTheirsAsync(Conflict conflict)
    {
        await ChangeSets.Wiki.RemoveAsync(conflict.Key);
        _conflicts!.Remove(conflict);
        Show(_conflicts.Count == 0
            ? "Konflikty rozstrzygnięte. Wyślij zmiany ponownie."
            : $"Usunięto ze zmian wiki: {conflict.Label}; zostanie wersja z repozytorium.");
        await ReloadAsync();
    }

    /// <summary>Adds the changes that undo a sent commit to the wiki changes, to be sent like any other.</summary>
    private async Task RevertAsync(WikiCommit commit, LocalBackup changes)
    {
        if (!await ChangeSets.Wiki.MergeAsync(changes))
        {
            Show("Przeglądarka nie pozwoliła zapisać wiki (tryb prywatny lub brak miejsca).", error: true);
            return;
        }

        _commitMessage ??= $"Cofnięcie: {commit.Title}";
        Show($"Dodano do zmian wiki cofnięcie „{commit.Title}” ({ProposalText.Changes(changes.Count)}). Sprawdź je w „Zatwierdzone, do wysłania” i wyślij.");
        await ReloadAsync();
    }

    private async Task ExportWikiAsync() =>
        await Store.DownloadAsync($"grimoire-studio-wiki-{DateTime.Now:yyyy-MM-dd}.json", await ChangeSets.Wiki.ExportAsync());

    private async Task ImportWikiAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            var count = await ChangeSets.Wiki.ImportAsync(await reader.ReadToEndAsync(), replace: false);
            Show($"Dodano do wiki: {ProposalText.Changes(count)} z pliku {e.File.Name}.");
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            Show(ex.Message, error: true);
        }

        await ReloadAsync();
    }

    private void Show(string message, bool error = false)
    {
        _message = message;
        _messageIsError = error;
    }

    public void Dispose() => ChangeSets.Changed -= OnChangeSetsChanged;
}
