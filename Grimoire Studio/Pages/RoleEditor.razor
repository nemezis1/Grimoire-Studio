@page "/roles/new"
@page "/roles/propose"
@page "/roles/{Id}/edit"
@inject GameDataClient Client
@inject ChangeSets Changes
@inject Proposals Proposals
@inject NavigationManager Nav
@inject LocalStore Store
@inject Grimoire_Studio.Generator.TokenRenderer Renderer

<PageTitle>@Heading@(IsNew ? null : $": {_namePl}") – Grimoire Studio</PageTitle>

<h1>@Heading</h1>
@if (IsProposal)
{
    <p class="muted">
        Rola zostanie zapisana w tej przeglądarce (w „Moich zmianach”) i od razu wysłana administratorowi do akceptacji. Po
        zatwierdzeniu stanie się częścią wiki.
    </p>
}
else
{
    <p class="muted">Zmiany są zapisywane tylko w tej przeglądarce. Rola z danych strony zostaje nietknięta i można do niej wrócić.</p>
}
@* English texts show by themselves when the role has its own translation; otherwise they are hidden until asked for. *@
<label class="field field--inline role-editor__english">
    <input type="checkbox" checked="@_showEnglish" @onchange="e => _showEnglish = e.Value is true" />
    <span>Pokaż wersję angielską</span>
</label>

@if (_data is null)
{
    <p class="notice">Wczytywanie…</p>
}
else if (!IsNew && _existing is null)
{
    <p>Rola <code>@Id</code> nie istnieje. <a href="roles">Wróć do listy ról</a>.</p>
}
else
{
    <div class="role-editor fill-viewport">
        <div class="role-editor__form">
            <section class="panel">
                <h2>Podstawowe</h2>
                <div class="field-row">
                    <label class="field">
                        <span>Nazwa (PL)</span>
                        <input type="text" @bind="_namePl" @bind:event="oninput" />
                    </label>
                    @if (_showEnglish)
                    {
                        <label class="field">
                            <span>Nazwa (EN)</span>
                            <input type="text" @bind="_nameEn" @bind:event="oninput" />
                        </label>
                    }
                </div>
                @if (IsNew)
                {
                    <label class="field">
                        <span>Identyfikator (małe litery i cyfry)</span>
                        <input type="text" value="@EffectiveId" @oninput="e => _id = e.Value?.ToString()" />
                    </label>
                    @if (IdError() is { } idError)
                    {
                        <p class="notice notice--error">@idError</p>
                    }
                }
                <div class="field-row">
                    @* Teams coloured as in the role list's filter. Keyed by the team, so choosing one closes the list. *@
                    <div class="field">
                        <span>Drużyna</span>
                        <details class="multi-select team-select" @key="_team">
                            <summary style="@Teams.Style(_team)">
                                <span class="multi-select__swatch" aria-hidden="true"></span>
                                <span>@(Teams.Parse(_team)?.NamePl ?? _team)</span>
                            </summary>
                            <div class="multi-select__menu">
                                @foreach (var t in Teams.All)
                                {
                                    <label class="field field--inline" style="@Teams.Style(t.Id)">
                                        <input type="radio" name="role-team" checked="@(t.Id == _team)" @onchange="() => _team = t.Id" />
                                        <span class="multi-select__swatch" aria-hidden="true"></span>
                                        <span>@t.NamePl</span>
                                    </label>
                                }
                            </div>
                        </details>
                    </div>
                </div>
                <label class="field field--inline">
                    <input type="checkbox" @bind="_official" />
                    <span>Oficjalna (wydana przez The Pandemonium Institute)</span>
                </label>
                <label class="field field--inline">
                    <input type="checkbox" @bind="_setup" />
                    <span>Wpływa na przygotowanie gry (np. zmienia liczbę Przybyszów)</span>
                </label>
            </section>

            <section class="panel">
                <h2>Zdolność</h2>
                <label class="field">
                    <span>Po polsku</span>
                    <textarea rows="3" @bind="_abilityPl" @bind:event="oninput"></textarea>
                </label>
                @if (_showEnglish)
                {
                    <label class="field">
                        <span>Po angielsku (opcjonalnie)</span>
                        <textarea rows="3" @bind="_abilityEn" @bind:event="oninput"></textarea>
                    </label>
                }
            </section>

            @foreach (var night in new[] { true, false })
            {
                var first = night;
                <section class="panel">
                    <h2>@(first ? "Pierwsza noc" : "Pozostałe noce")</h2>
                    <div class="field-row">
                        <label class="field">
                            <span>Pozycja w kolejności (0 = nie budzi się)</span>
                            <input type="number" min="0" step="1" value="@(first ? _firstNight : _otherNight)"
                                   @onchange="e => SetOrder(first, e.Value)" />
                        </label>
                        <label class="field">
                            <span>Ustaw po roli</span>
                            <select value="" @onchange="e => PlaceAfter(first, e.Value?.ToString())">
                                <option value="">— wybierz —</option>
                                @foreach (var (role, order) in Waking(first))
                                {
                                    <option value="@role.Id">#@order @role.NamePl</option>
                                }
                            </select>
                        </label>
                    </div>
                    <p class="muted small">@Neighbours(first)</p>
                    <div class="field-row">
                        <label class="field">
                            <span>Tekst dla narratora (PL)</span>
                            <textarea rows="3" value="@(first ? _firstReminderPl : _otherReminderPl)"
                                      @oninput="e => { if (first) _firstReminderPl = e.Value?.ToString() ?? string.Empty; else _otherReminderPl = e.Value?.ToString() ?? string.Empty; }"></textarea>
                        </label>
                        @if (_showEnglish)
                        {
                            <label class="field">
                                <span>Tekst dla narratora (EN)</span>
                                <textarea rows="3" value="@(first ? _firstReminderEn : _otherReminderEn)"
                                          @oninput="e => { if (first) _firstReminderEn = e.Value?.ToString() ?? string.Empty; else _otherReminderEn = e.Value?.ToString() ?? string.Empty; }"></textarea>
                            </label>
                        }
                    </div>
                </section>
            }

            <section class="panel">
                <h2>Znaczniki przypomnień</h2>
                <p class="muted small">
                    Nazwy żetonów przypomnień tej roli.@(_showEnglish ? " Puste pole angielskie oznacza „jak po polsku”." : null)
                </p>
                <ReminderTiles Items="_reminders" ShowEnglish="_showEnglish" Label="Znacznik" Changed="StateHasChanged" />
                <h3 class="reminder-tiles__heading">Znaczniki globalne</h3>
                <p class="muted small">Działają niezależnie od tego, czy rola jest w grze (np. „Jest Pijakiem”).</p>
                <ReminderTiles Items="_globalReminders" ShowEnglish="_showEnglish" Label="Znacznik globalny" Changed="StateHasChanged" />
            </section>
        </div>

        <aside class="panel role-editor__summary">
            @* The token as the generator draws it with its default look, redrawn as the form changes. *@
            <h2>Podgląd tokena</h2>
            <canvas class="role-editor__token" @ref="_tokenCanvas" width="@TokenPreviewSize" height="@TokenPreviewSize"></canvas>
            <p class="muted small">Domyślny wygląd z generatora; własny wygląd ustawisz w <a href="@($"generator?role={EffectiveId}")">generatorze tokenów</a>.</p>

            <h2>Ikona</h2>
            <div class="role-editor__icon">
                <img src="@IconPreview" alt="" onerror="this.onerror = null; this.src = 'Assets/token.png';" />
            </div>
            <div class="field-row">
                <label class="button button--ghost button--file">
                    Wczytaj ikonę…
                    <InputFile accept="image/png,image/jpeg,image/webp" OnChange="UploadIconAsync" />
                </label>
                @if (_iconUrl is not null)
                {
                    <button class="button button--ghost" @onclick="() => _iconUrl = null">Usuń własną ikonę</button>
                }
            </div>
            <p class="muted small">Ikona jest zmniejszana do 256 px i zapisywana razem z rolą.</p>

            @if (IsProposal)
            {
                <h2>Zgłoszenie</h2>
                <label class="field">
                    <span>Podpis</span>
                    <input type="text" @bind="_author" @bind:event="oninput" placeholder="np. nick z Discorda" />
                </label>
                <label class="field">
                    <span>Komentarz dla administratora</span>
                    <input type="text" @bind="_comment" @bind:event="oninput" placeholder="skąd rola, co warto wiedzieć" />
                </label>
            }

            @if (_error is not null)
            {
                <p class="notice notice--error">@_error</p>
            }
            <div class="field-row">
                @if (IsProposal)
                {
                    <button class="button" disabled="@(string.IsNullOrWhiteSpace(_author) || _busy)" @onclick="SaveAsync">
                        @(_busy ? "Wysyłanie…" : "Wyślij do akceptacji")
                    </button>
                }
                else
                {
                    <button class="button" @onclick="SaveAsync">Zapisz</button>
                }
                <a class="button button--ghost" href="@(IsNew ? "roles" : $"roles/{Id}")">Anuluj</a>
            </div>
        </aside>
    </div>
}

@code {
    private const long MaxIconBytes = 5 * 1024 * 1024;

    [Parameter]
    public string? Id { get; set; }

    private bool IsNew => Id is null;

    /// <summary>"Zgłoś nową rolę": a new role saved to the visitor's changes and sent for approval at once.</summary>
    private bool IsProposal => IsNew && Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') == "roles/propose";

    private string Heading => IsProposal ? "Zgłoś nową rolę" : IsNew ? "Nowa rola" : "Edycja roli";

    /// <summary>Signature of proposals, shared with the "Moje zmiany" page.</summary>
    private const string AuthorKey = "grimoire-studio.author";

    private string _author = string.Empty;
    private string _comment = string.Empty;
    private bool _busy;

    private GameData? _data;
    private Role? _existing;
    private string _namePl = string.Empty;
    private string _nameEn = string.Empty;
    private string _team = TeamIds.Townsfolk;
    private bool _setup;
    private bool _official;
    private string _abilityPl = string.Empty;
    private string _abilityEn = string.Empty;
    private int _firstNight;
    private int _otherNight;
    private string _firstReminderPl = string.Empty;
    private string _otherReminderPl = string.Empty;
    private string _firstReminderEn = string.Empty;
    private string _otherReminderEn = string.Empty;
    private List<ReminderText> _reminders = [];
    private List<ReminderText> _globalReminders = [];
    private string? _iconUrl;
    private string? _error;

    /// <summary>The English texts are shown: at first when the role has its own translation (<see cref="HasEnglish"/>).</summary>
    private bool _showEnglish;

    protected override async Task OnInitializedAsync() => _author = await Store.GetSettingAsync(AuthorKey) ?? string.Empty;

    /// <summary>Some English text of the role differs from the Polish one (a missing translation repeats the Polish text).</summary>
    private static bool HasEnglish(Role role) =>
        Translated(role.NameEn, role.NamePl)
        || Translated(role.AbilityEn, role.AbilityPl)
        || Translated(role.FirstNightReminderEn, role.FirstNightReminderPl)
        || Translated(role.OtherNightReminderEn, role.OtherNightReminderPl)
        || Translated(role.RemindersEn, role.RemindersPl)
        || Translated(role.RemindersGlobalEn, role.RemindersGlobalPl);

    private static string OwnEnglish(string english, string polish) => Translated(english, polish) ? english : string.Empty;

    private static bool Translated(string english, string polish) =>
        !string.IsNullOrWhiteSpace(english) && !string.Equals(english.Trim(), polish.Trim(), StringComparison.Ordinal);

    private static bool Translated(IReadOnlyList<string> english, IReadOnlyList<string> polish) =>
        english.Where((text, i) => Translated(text, i < polish.Count ? polish[i] : string.Empty)).Any();

    /// <summary>Id typed for a new role; null until edited, then the suggestion from the name is used.</summary>
    private string? _id;

    private string EffectiveId => (_id ?? NewId()).Trim();

    private string IconPreview => _iconUrl ?? (IsNew ? "Assets/token.png" : Changes.IconUrl(Id!));

    protected override async Task OnParametersSetAsync()
    {
        _data = await Client.GetAsync();
        _existing = Id is null ? null : _data.FindRole(Id);
        if (_existing is not { } role)
        {
            _showEnglish = false;
            return;
        }

        _showEnglish = HasEnglish(role);

        _namePl = role.NamePl;
        // An English text equal to the Polish one is the copy made when saving without a translation: shown empty.
        _nameEn = OwnEnglish(role.NameEn, role.NamePl);
        _team = role.Team;
        _setup = role.Setup;
        _official = role.IsOfficial == true;
        _abilityPl = role.AbilityPl;
        _abilityEn = OwnEnglish(role.AbilityEn, role.AbilityPl);
        _firstNight = role.FirstNight;
        _otherNight = role.OtherNight;
        _firstReminderPl = role.FirstNightReminderPl;
        _otherReminderPl = role.OtherNightReminderPl;
        _firstReminderEn = role.FirstNightReminderEn;
        _otherReminderEn = role.OtherNightReminderEn;
        _reminders = ReminderText.From(role.RemindersPl, role.RemindersEn);
        _globalReminders = ReminderText.From(role.RemindersGlobalPl, role.RemindersGlobalEn);
        _iconUrl = (await (await Changes.GetCurrentAsync()).Roles.FindAsync(role.Id))?.IconUrl;
    }

    private IEnumerable<(Role Role, int Order)> Waking(bool firstNight) =>
        (_data?.AllRoles ?? [])
            .Where(r => !string.Equals(r.Id, Id, StringComparison.OrdinalIgnoreCase))
            .Select(r => (Role: r, Order: firstNight ? r.FirstNight : r.OtherNight))
            .Where(x => x.Order > 0)
            .OrderBy(x => x.Order);

    private string Neighbours(bool firstNight)
    {
        var order = firstNight ? _firstNight : _otherNight;
        if (order <= 0)
        {
            return "Rola nie budzi się tej nocy.";
        }

        var waking = Waking(firstNight).ToList();
        var before = waking.LastOrDefault(x => x.Order <= order);
        var after = waking.FirstOrDefault(x => x.Order > order);
        return $"Budzi się po: {(before.Role is null ? "—" : $"{before.Role.NamePl} (#{before.Order})")}, "
            + $"przed: {(after.Role is null ? "—" : $"{after.Role.NamePl} (#{after.Order})")}.";
    }

    private void SetOrder(bool firstNight, object? value)
    {
        var order = int.TryParse(value?.ToString(), out var parsed) ? Math.Max(0, parsed) : 0;
        if (firstNight)
        {
            _firstNight = order;
        }
        else
        {
            _otherNight = order;
        }
    }

    // Halfway between the chosen role and the next one, so the new position is unique when there is room.
    private void PlaceAfter(bool firstNight, string? roleId)
    {
        var waking = Waking(firstNight).ToList();
        var index = waking.FindIndex(x => x.Role.Id == roleId);
        if (index < 0)
        {
            return;
        }

        var order = waking[index].Order;
        var next = index + 1 < waking.Count ? waking[index + 1].Order : order + 10;
        SetOrder(firstNight, next - order > 1 ? (order + next) / 2 : order);
    }

    private async Task UploadIconAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            using var stream = e.File.OpenReadStream(MaxIconBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _iconUrl = await (await Changes.GetCurrentAsync()).Roles.ShrinkIconAsync($"data:{e.File.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}");
        }
        catch (IOException)
        {
            _error = $"Plik jest za duży (maksymalnie {MaxIconBytes / 1024 / 1024} MB).";
        }
    }

    /// <summary>Format and uniqueness of a new role's id (against the data folder and roles saved locally).</summary>
    private string? IdError()
    {
        if (!IsNew)
        {
            return null;
        }

        var id = EffectiveId;
        if (id.Length == 0)
        {
            // With no name yet the empty id is expected; saving asks for the name first.
            return string.IsNullOrWhiteSpace(_namePl) && string.IsNullOrWhiteSpace(_nameEn) ? null : "Podaj identyfikator roli.";
        }

        if (!DataValidator.IsValidId(id))
        {
            return "Identyfikator może zawierać tylko małe litery (bez polskich znaków) i cyfry.";
        }

        return _data?.FindRole(id) is { } other ? $"Rola o identyfikatorze „{id}” już istnieje ({other.NamePl})." : null;
    }

    /// <summary>
    /// Id for a new role: the English (or Polish) name in lowercase letters and digits, numbered when taken; empty while
    /// there is no name.
    /// </summary>
    private string NewId()
    {
        var name = string.IsNullOrWhiteSpace(_nameEn) ? _namePl : _nameEn;
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        var baseId = new string(SearchText.Fold(name).Where(char.IsAsciiLetterOrDigit).ToArray());
        if (baseId.Length == 0)
        {
            baseId = "rola";
        }

        var id = baseId;
        for (var n = 2; _data?.FindRole(id) is not null; n++)
        {
            id = $"{baseId}{n}";
        }

        return id;
    }


    private async Task SaveAsync()
    {
        if (IdError() is { } idError)
        {
            _error = idError;
            return;
        }

        if (string.IsNullOrWhiteSpace(_namePl) || string.IsNullOrWhiteSpace(_abilityPl))
        {
            _error = "Podaj nazwę i zdolność po polsku.";
            return;
        }

        var role = BuildRole();

        // A proposal is the visitor's own change, also while the admin edits the wiki directly.
        var changes = IsProposal ? Changes.Personal : await Changes.GetCurrentAsync();
        if (!await changes.Roles.SaveAsync(new LocalRole(role, _iconUrl)))
        {
            _error = "Przeglądarka nie pozwoliła zapisać roli (tryb prywatny lub brak miejsca).";
            return;
        }

        if (IsProposal && !await SubmitAsync(role.Id))
        {
            return;
        }

        Nav.NavigateTo(IsProposal ? "changes" : Changes.Reviewing is not null ? "admin" : $"roles/{role.Id}");
    }

    /// <summary>Sends the saved role for approval; false (with the error shown) when it could not be sent.</summary>
    private async Task<bool> SubmitAsync(string roleId)
    {
        _busy = true;
        try
        {
            var proposal = await Proposals.SubmitAsync(new Proposal
            {
                Id = Guid.NewGuid().ToString("N"),
                Author = _author.Trim(),
                Comment = _comment.Trim(),
                CreatedAt = DateTimeOffset.Now,
                Changes = (await Changes.Personal.GetAllAsync()).Only(new HashSet<string> { LocalBackup.RoleKey(roleId) }),
            });
            await Store.SetSettingAsync(AuthorKey, proposal.Author);
            return true;
        }
        catch (Exception ex) when (ex is PublishException or IOException)
        {
            _error = $"Rola jest zapisana w tej przeglądarce, ale nie udało się wysłać zgłoszenia: {ex.Message} Spróbuj ponownie albo zgłoś ją z „Moich zmian”.";
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The role as the form describes it: the role being edited (or a new one) with the form's values.</summary>
    private Role BuildRole()
    {
        var baseRole = _existing ?? new Role
        {
            Id = EffectiveId,
            NameEn = string.Empty,
            NamePl = string.Empty,
            AbilityEn = string.Empty,
            AbilityPl = string.Empty,
        };

        // English texts stay as they were; for new texts without a translation the Polish one is used.
        var role = baseRole with
        {
            NamePl = _namePl.Trim(),
            NameEn = string.IsNullOrWhiteSpace(_nameEn) ? _namePl.Trim() : _nameEn.Trim(),
            Team = _team,
            // The edition is not edited here: an existing role keeps its own.
            Edition = _team == TeamIds.Fabled ? string.Empty : baseRole.Edition,
            Setup = _setup,
            IsOfficial = _official,
            AbilityPl = _abilityPl.Trim(),
            AbilityEn = string.IsNullOrWhiteSpace(_abilityEn) ? _abilityPl.Trim() : _abilityEn.Trim(),
            FirstNight = _firstNight,
            OtherNight = _otherNight,
            FirstNightReminderPl = _firstReminderPl.Trim(),
            OtherNightReminderPl = _otherReminderPl.Trim(),
            FirstNightReminderEn = _firstReminderEn.Trim(),
            OtherNightReminderEn = _otherReminderEn.Trim(),
            RemindersPl = ReminderText.Polish(_reminders),
            RemindersEn = ReminderText.English(_reminders),
            RemindersGlobalPl = ReminderText.Polish(_globalReminders),
            RemindersGlobalEn = ReminderText.English(_globalReminders),
        };

        return role;
    }

    private const int TokenPreviewSize = 500;
    private ElementReference _tokenCanvas;

    /// <summary>The preview token: default look, the team's border colours and the role's texts, icon and leaves.</summary>
    private Grimoire_Studio.Generator.TokenSettings PreviewSettings()
    {
        var role = BuildRole();
        if (role.NamePl.Length == 0)
        {
            role = role with { NamePl = "Nazwa roli" };
        }

        var settings = new Grimoire_Studio.Generator.TokenSettings();
        // A new role without an uploaded icon has no picture yet.
        settings.ApplyRole(role, _iconUrl ?? (IsNew ? null : Changes.IconUrl(Id!)));
        if (_data is not null)
        {
            settings.ApplyTeamBorder(_data, role);
        }

        return settings;
    }

    // Every change of the form re-renders the page, so drawing here keeps the preview current.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null && (IsNew || _existing is not null))
        {
            await Renderer.RenderAsync(_tokenCanvas, PreviewSettings(), TokenPreviewSize);
        }
    }
}
