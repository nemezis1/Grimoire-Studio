@inherits LayoutComponentBase
@inject ChangeSets ChangeSets
@inject NavigationManager Nav
@implements IDisposable

<header class="site-header">
    <div class="site-header__inner">
        <a class="site-title logo" href=""><span class="logo__main">Grimoire</span><span class="logo__studio">Studio</span></a>
        <GlobalSearch />
        <ThemeToggle />
        @* Narrow screens: the links fold behind this button, so the header stays one line. *@
        <button class="site-menu" aria-expanded="@_menuOpen" aria-controls="site-nav" @onclick="() => _menuOpen = !_menuOpen">
            @(_menuOpen ? "✕ Zamknij" : "☰ Menu")
        </button>
        <nav id="site-nav" class="site-nav @(_menuOpen ? "site-nav--open" : null)">
            <NavLink href="roles">Role</NavLink>
            <NavLink href="scripts">Skrypty</NavLink>
            <NavLink href="jinxes">Jinxy</NavLink>
            <NavLink href="generator">Generator</NavLink>
            @* Less used pages: under "Więcej" on wide screens; the phone menu lists them with the others. *@
            <details class="nav-more">
                <summary>Więcej</summary>
                <div class="nav-more__menu">
                    @MorePages
                </div>
            </details>
            <span class="nav-more__flat">@MorePages</span>
            @if (ChangeSets.IsAdmin)
            {
                <AdminLink />
            }
        </nav>
    </div>
</header>

@if (ChangeSets.EditingWiki)
{
    <div class="wiki-banner">
        Edytujesz wiki bezpośrednio: zapisy w edytorach trafiają do wiki, nie do „Moich zmian”.
        <a href="admin">Zmień w panelu administratora</a>
    </div>
}

<main class="site-main">
    <div class="page">
        @Body
    </div>
</main>

@* Only on the home page: elsewhere the work area gets the height. *@
@if (IsHome)
{
    <footer class="site-footer">
        Projekt fanowski, niezwiązany z The Pandemonium Institute. Blood on the Clocktower jest znakiem towarowym The Pandemonium Institute.
    </footer>
}

@code {
    private bool _menuOpen;

    private static readonly RenderFragment MorePages = @<text>
        <NavLink href="teams">Drużyny</NavLink>
        <NavLink href="changes">Moje zmiany</NavLink>
        <NavLink href="info">Informacje</NavLink>
    </text>;

    private bool IsHome => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Length == 0;

    protected override async Task OnInitializedAsync()
    {
        ChangeSets.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await ChangeSets.LoadAsync();
        await EnterAdminFromAddressAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        await InvokeAsync(async () =>
        {
            _menuOpen = false;
            await EnterAdminFromAddressAsync();
            StateHasChanged();
        });

    /// <summary>
    /// An address with ?admin opens the admin mode for this browsing session; the parameter is then removed from the
    /// address, so links and reloads do not carry it.
    /// </summary>
    private async Task EnterAdminFromAddressAsync()
    {
        if (!ChangeSets.HasAdminParameter(Nav.Uri))
        {
            return;
        }

        await ChangeSets.SetAdminAsync(true);
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(ChangeSets.AdminParameter, (string?)null), replace: true);
    }

    public void Dispose()
    {
        ChangeSets.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
