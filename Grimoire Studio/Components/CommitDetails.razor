@* Folded list of what one repository commit changed, read from the repository when first unfolded; it can be undone. *@
@using System.Text.Json
@inject RepositoryPublisher Publisher
@inject HttpClient Http

<details class="proposal-changes">
    <summary @onclick="LoadAsync">Pokaż zmiany</summary>
    @if (_error is not null)
    {
        <p class="notice notice--error">@_error</p>
    }
    else if (_changes is null)
    {
        <p class="muted small">Wczytywanie zmian z repozytorium…</p>
    }
    else if (_changes.Items.Count == 0)
    {
        <p class="muted small">Commit nie zmienia ról, skryptów, drużyn ani jinxów.</p>
    }
    else
    {
        <ul class="change-list">
            @foreach (var item in _changes.Items)
            {
                var rows = ItemDiff.Changes(item.Before, item.After);
                var role = item.Kind == "role" ? Data.FindRole(item.Id) : null;
                <li style="@(role is null ? null : Teams.Style(role.Team))">
                    <span class="change-list__what">
                        @if (role is not null)
                        {
                            <RoleLink Role="role" />
                        }
                        else
                        {
                            <strong>@ItemLabel.Of(Data, item.Kind, item.Id, item.After ?? item.Before)</strong>
                        }
                        <span class="local-badge">@Badge(item)</span>
                        @if (item.Before is not null && item.After is not null && rows.Count > 0)
                        {
                            <span class="change-list__fields">@string.Join(", ", rows.Select(r => r.Label))</span>
                        }
                    </span>
                    <ItemDiffTable Rows="rows" Icon="@(item.IconChanged ? ItemDiffTable.IconAt(Commit.Url, Commit.Sha, item.Id) : null)" Open="true" />
                </li>
            }
        </ul>

        @if (OnRevert.HasDelegate)
        {
            @if (_revert is null)
            {
                <button class="button button--ghost" disabled="@_busy" @onclick="PrepareRevertAsync">@(_busy ? "Przygotowywanie…" : "Cofnij te zmiany…")</button>
            }
            else
            {
                <div class="panel">
                    <p>
                        Cofnięcie doda do zmian wiki poprzednie wersje: @(_revert.Labels.Count == 0 ? "nic" : string.Join(", ", _revert.Labels)).
                        Trafią do „Zatwierdzone, do wysłania”; do repozytorium wyślesz je jak inne zmiany.
                    </p>
                    @if (_revert.ChangedLater.Count > 0)
                    {
                        <p class="notice notice--warning">
                            Zmienione po tym commicie: @string.Join(", ", _revert.ChangedLater). Cofnięcie usunie też te późniejsze zmiany.
                        </p>
                    }
                    @if (_revert.Changes.Removed.Count > 0)
                    {
                        <p class="notice notice--warning">
                            Dodane w tym commicie, więc cofnięcie je usunie: @string.Join(", ", _revert.Removed).
                        </p>
                    }
                    <div class="field-row">
                        <button class="button" disabled="@(_revert.Changes.Count == 0)" @onclick="RevertAsync">Dodaj cofnięcie do zmian wiki</button>
                        <button class="button button--ghost" @onclick="() => _revert = null">Anuluj</button>
                    </div>
                </div>
            }
        }
    }
</details>

@code {
    [Parameter, EditorRequired]
    public WikiCommit Commit { get; set; } = default!;

    /// <summary>Data used for names and team colours.</summary>
    [Parameter, EditorRequired]
    public GameData Data { get; set; } = default!;

    /// <summary>The wiki now, to tell which items changed again after the commit.</summary>
    [Parameter]
    public GameData? Wiki { get; set; }

    /// <summary>Takes the changes that undo the commit; without it the commit cannot be undone here.</summary>
    [Parameter]
    public EventCallback<LocalBackup> OnRevert { get; set; }

    private CommitChanges? _changes;
    private string? _error;
    private Revert? _revert;
    private bool _busy;

    private sealed record Revert(LocalBackup Changes, IReadOnlyList<string> Labels, IReadOnlyList<string> ChangedLater, IReadOnlyList<string> Removed);

    private async Task LoadAsync()
    {
        if (_changes is not null)
        {
            return;
        }

        try
        {
            _error = null;
            _changes = await Publisher.GetCommitChangesAsync(Commit.Sha);
        }
        catch (PublishException ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>
    /// The items as they were before the commit: changed and removed ones come back, added jinxes are removed, and a
    /// changed icon is taken from the commit before. Added roles, scripts and teams are removed.
    /// </summary>
    private async Task PrepareRevertAsync()
    {
        _busy = true;
        try
        {
            var (roles, scripts, teams, jinxes) = (new List<LocalRole>(), new List<Script>(), new List<TeamInfo>(), new List<JinxOverride>());
            var (labels, later, removed, removedKeys) = (new List<string>(), new List<string>(), new List<string>(), new List<string>());
            foreach (var item in _changes!.Items)
            {
                var label = ItemLabel.Of(Data, item.Kind, item.Id, item.After ?? item.Before);
                var key = $"{item.Kind}:{item.Id}";
                if (item.Before is null && item.After is not null && item.Kind != "jinx")
                {
                    removed.Add(label);
                    removedKeys.Add(key);
                    continue;
                }

                switch (item.Kind)
                {
                    case "role":
                        var role = item.Before?.Deserialize<Role>(GameData.JsonOptions) ?? Wiki?.FindRole(item.Id);
                        if (role is null)
                        {
                            continue;
                        }

                        var icon = item.IconChanged && _changes.Parent is { } parent ? await IconAsync(parent, item.Id) : null;
                        roles.Add(new LocalRole(role, icon));
                        if (item.After is { } roleAfter && ChangedLater(key, roleAfter.Deserialize<Role>(GameData.JsonOptions)))
                        {
                            later.Add(label);
                        }

                        break;

                    case "script":
                        scripts.Add(item.Before!.Value.Deserialize<Script>(GameData.JsonOptions)!);
                        if (item.After is { } scriptAfter && ChangedLater(key, scriptAfter.Deserialize<Script>(GameData.JsonOptions)))
                        {
                            later.Add(label);
                        }

                        break;

                    case "team":
                        teams.Add(item.Before!.Value.Deserialize<TeamInfo>(GameData.JsonOptions)!);
                        if (item.After is { } teamAfter && ChangedLater(key, teamAfter.Deserialize<TeamInfo>(GameData.JsonOptions)))
                        {
                            later.Add(label);
                        }

                        break;

                    case "jinx":
                        var json = (item.Before ?? item.After)!.Value;
                        var owner = json.GetProperty("owner").GetString()!;
                        jinxes.Add(new JinxOverride
                        {
                            OwnerId = owner,
                            Jinx = json.Deserialize<Jinx>(GameData.JsonOptions)!,
                            Removed = item.Before is null,
                        });
                        if (item.After is { } jinxAfter && ChangedLater(key, jinxAfter.Deserialize<Jinx>(GameData.JsonOptions)))
                        {
                            later.Add(label);
                        }

                        break;

                    default:
                        continue;
                }

                labels.Add(label);
            }

            _revert = new Revert(
                new LocalBackup { BaseVersion = Commit.Sha, Roles = roles, Scripts = scripts, Teams = teams, Jinxes = jinxes, Removed = removedKeys },
                labels,
                later,
                removed);
        }
        catch (Exception ex) when (ex is JsonException or KeyNotFoundException or InvalidOperationException or HttpRequestException)
        {
            _error = $"Nie udało się przygotować cofnięcia: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The item in the wiki now differs from what the commit left.</summary>
    private bool ChangedLater<T>(string key, T? after) =>
        Wiki is not null && after is not null && ItemConflicts.Json(Wiki, key) != DataFiles.ToJson(after);

    /// <summary>A role's icon at a commit, as a data URL; null when the role had none there.</summary>
    private async Task<string?> IconAsync(string sha, string roleId)
    {
        if (ItemDiffTable.IconAt(Commit.Url, sha, roleId) is not { } url)
        {
            return null;
        }

        using var response = await Http.GetAsync(url);
        return response.IsSuccessStatusCode
            ? "data:image/png;base64," + Convert.ToBase64String(await response.Content.ReadAsByteArrayAsync())
            : null;
    }

    private async Task RevertAsync()
    {
        await OnRevert.InvokeAsync(_revert!.Changes);
        _revert = null;
    }

    private static string Badge(CommitItem item)
    {
        var masculine = item.Kind is "script" or "jinx";
        return (item.Before, item.After) switch
        {
            (null, not null) => masculine ? "dodany" : "dodana",
            (not null, null) => masculine ? "usunięty" : "usunięta",
            (null, null) => "nowa ikona",
            _ => (masculine ? "zmieniony" : "zmieniona") + (item.IconChanged ? ", nowa ikona" : null),
        };
    }
}
