@* The team's name in its colour; leads to the list of roles filtered to that team. *@
<a class="team-badge team--@(Team)" style="@Teams.Style(Team)" href="roles?team=@Uri.EscapeDataString(Team)"
   title="Wszystkie role: @Teams.Plural(Team)">@Teams.Singular(Team)</a>

@code {
    [Parameter, EditorRequired]
    public string Team { get; set; } = string.Empty;
}
