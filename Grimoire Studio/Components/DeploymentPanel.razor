@*
    Wiki changes being deployed: shown after sending (and while any sent change is still deploying), gone once the
    deployment succeeds; a failed deployment of the changes sent from here stays until the next check finds none running.
*@
@inject RepositoryPublisher Publisher
@implements IDisposable

@if (_error is not null || _watching || Shown.Count > 0)
{
    <div class="deployments">
        <div class="form-list__head">
            <h3>Wdrażanie zmian wiki</h3>
            <button class="button button--ghost" disabled="@_loading" @onclick="RefreshAsync">@(_loading ? "Sprawdzanie…" : "Odśwież")</button>
        </div>

        @if (_error is not null)
        {
            <p class="notice notice--error">@_error</p>
        }
        else
        {
            @if (Shown.Any(r => r.IsRunning) || (_watching && Shown.Count == 0))
            {
                <p class="muted small">
                    Po końcu wdrażania zmiany będą widoczne dla wszystkich; ta karta pokaże je po odświeżeniu strony (F5).
                    Sprawdzam co @PollSeconds s.
                </p>
            }
            @if (_watching && Shown.Count == 0)
            {
                <p class="muted small">Czekam, aż GitHub zacznie wdrażanie…</p>
            }
            <ul class="change-list">
                @foreach (var run in Shown)
                {
                    <li>
                        <span class="change-list__what">
                            <span class="local-badge deployment--@(run.IsRunning ? "running" : run.Succeeded ? "done" : "failed")">@run.StatusText</span>
                            @run.Title
                            <span class="change-list__fields">
                                <a href="@run.Url" target="_blank" rel="noopener noreferrer"><code>@run.ShortSha</code></a>
                                · @run.Author · @run.StartedAt.ToLocalTime().ToString("g")
                            </span>
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    private const int PollSeconds = 15;

    /// <summary>Told after each check, so the history can show how its commits deployed.</summary>
    [Parameter]
    public EventCallback<DeploymentStatus> StatusChanged { get; set; }

    private DeploymentStatus? _status;
    private string? _error;
    private bool _loading;
    private CancellationTokenSource? _polling;

    /// <summary>Commit sent from this tab whose deployment is followed until it succeeds.</summary>
    private string? _sent;

    /// <summary>Changes were sent and their deployment has not finished (or not shown up) yet.</summary>
    private bool _watching;

    /// <summary>Running deployments, plus the one of the changes sent from here when it did not succeed.</summary>
    private List<DeploymentRun> Shown =>
        _status?.Runs.Where(r => r.IsRunning || (!r.Succeeded && IsSent(r))).ToList() ?? [];

    private bool IsSent(DeploymentRun run) => _sent is not null && run.Sha.StartsWith(_sent, StringComparison.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => RefreshAsync();

    /// <summary>Checks now, and keeps checking while a deployment runs.</summary>
    public async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            _status = await Publisher.GetDeploymentsAsync();
            _error = null;
            await StatusChanged.InvokeAsync(_status);
        }
        catch (PublishException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        if (_status?.Runs.FirstOrDefault(IsSent) is { IsRunning: false })
        {
            _watching = false;
        }

        if (_status?.AnyRunning == true && _polling is null)
        {
            _polling = new CancellationTokenSource();
            _ = PollAsync(_polling.Token);
        }
    }

    /// <summary>
    /// Follows the deployment of a commit just sent. A push starts its run a few seconds later, so it polls even before
    /// the run shows up.
    /// </summary>
    public void Watch(string sha)
    {
        _sent = sha;
        _watching = true;
        if (_polling is null)
        {
            _polling = new CancellationTokenSource();
            _ = PollAsync(_polling.Token, minimumChecks: 4);
        }
    }

    private async Task PollAsync(CancellationToken cancel, int minimumChecks = 0)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(PollSeconds));
            var checks = 0;
            while (await timer.WaitForNextTickAsync(cancel))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });

                if (++checks >= minimumChecks && _status?.AnyRunning != true)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The panel was closed.
        }
        finally
        {
            _polling = null;
            if (_watching && !cancel.IsCancellationRequested)
            {
                // The run never showed up within the checks: stop waiting for it.
                _watching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public void Dispose() => _polling?.Cancel();
}
