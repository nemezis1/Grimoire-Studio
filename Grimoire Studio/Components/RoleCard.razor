@inject RolePreferences Preferences

<li class="role-grid__item @(Preferences.IsDisliked(Role.Id) ? "role-grid__item--disliked" : null)">
    <a class="role-card team--@(Role.Team)" style="@Teams.Style(Role.Team)" href="roles/@Role.Id">
        @if (Order is not null)
        {
            <span class="role-card__order">@Order</span>
        }
        <RoleIcon Role="Role" />
        <div class="role-card__body">
            <div class="role-card__name">@Role.NamePl <span class="muted">@Role.NameEn</span>
                @if (Role.IsOfficial != true)
                {
                    <span class="experimental-badge" title="Rola nieoficjalna (fanowska)">nieofic.</span>
                }
                <ChangeBadge Key="@LocalBackup.RoleKey(Role.Id)" Feminine="true" /></div>
            <p class="role-card__ability">@Role.AbilityPl</p>
        </div>
    </a>
    <WikiLink Role="Role" />
    <RolePreferenceButtons RoleId="@Role.Id" />
</li>

@code {
    [Parameter, EditorRequired]
    public Role Role { get; set; } = default!;

    /// <summary>Position in the night order, shown when the list is sorted by night.</summary>
    [Parameter]
    public int? Order { get; set; }
}
