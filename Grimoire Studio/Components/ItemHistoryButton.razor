@* "Historia zmian" of one role, script or jinx, read from the repository; for a signed-in admin only. *@
@inject ChangeSets ChangeSets
@inject RepositoryPublisher Publisher

@if (ChangeSets.IsAdmin && Publisher.AdminName is not null)
{
    <button class="@CssClass" @onclick="OpenAsync">@Label</button>
}

@if (_open)
{
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-label="Historia zmian: @Title">
        <header class="modal__header">
            <h2>Historia zmian: @Title</h2>
            <button class="button button--ghost" @onclick="Close">Zamknij</button>
        </header>
        <div class="modal__body">
            @if (_error is not null)
            {
                <p class="notice notice--error">@_error</p>
            }
            else if (_history is null)
            {
                <p class="muted">Wczytywanie historii z repozytorium…</p>
            }
            else if (_history.Entries.Count == 0)
            {
                <p class="muted">W ostatnich zmianach repozytorium ta pozycja się nie zmieniała.</p>
            }
            else
            {
                @* Same look as "Moje zmiany": one row per commit, the differences folded below it. *@
                <ul class="change-list">
                    @foreach (var entry in _history.Entries)
                    {
                        var rows = ItemDiff.Changes(entry.Before, entry.After);
                        <li style="@Style">
                            <span class="change-list__what">
                                <strong>@entry.Title</strong>
                                <span class="local-badge">@Badge(entry)</span>
                                <span class="change-list__fields">
                                    @entry.Date.ToLocalTime().ToString("g")
                                    · @(entry.ApprovedBy is { } approver ? $"zatwierdził: {approver}" : entry.Author)
                                    @if (entry.Proposals is not null)
                                    {
                                        <span> · zgłosili: @entry.Proposals</span>
                                    }
                                    · <a href="@entry.Url" target="_blank" rel="noopener noreferrer"><code>@entry.ShortSha</code></a>
                                </span>
                                @if (entry.Before is not null && entry.After is not null && rows.Count > 0)
                                {
                                    <span class="change-list__fields">@string.Join(", ", rows.Select(r => r.Label))</span>
                                }
                            </span>
                            @if (rows.Count > 0 || entry.IconChanged)
                            {
                                <details class="change-details" open="@(entry == _history.Entries[0])">
                                    <summary>Różnice</summary>
                                    <table>
                                        <thead>
                                            <tr><th></th><th>Było</th><th>Jest</th></tr>
                                        </thead>
                                        <tbody>
                                            @if (entry.IconChanged && IconAt(entry) is { } icon)
                                            {
                                                <tr>
                                                    <th>Ikona</th>
                                                    <td class="change-details__before"></td>
                                                    <td class="change-details__after"><img src="@icon" alt="" /></td>
                                                </tr>
                                            }
                                            @foreach (var (label, before, after) in rows)
                                            {
                                                <tr>
                                                    <th>@label</th>
                                                    <td class="change-details__before">@before</td>
                                                    <td class="change-details__after">@after</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </details>
                            }
                        </li>
                    }
                </ul>
                @if (!_history.Complete)
                {
                    <p class="muted small">Pokazane są zmiany z ostatnich commitów; starsze są w historii repozytorium na GitHubie.</p>
                }
            }
        </div>
    </div>
}

@code {
    /// <summary>"role", "script" or "jinx".</summary>
    [Parameter, EditorRequired]
    public string Kind { get; set; } = string.Empty;

    /// <summary>Role or script id; for a jinx "role/role".</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    /// <summary>Data file of a role: "roles" or "fabled".</summary>
    [Parameter]
    public string? File { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Historia zmian";

    /// <summary>Inline style of each row, e.g. the team colour of a role.</summary>
    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "button button--ghost";

    private bool _open;
    private ItemHistory? _history;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ChangeSets.LoadAsync();
        await Publisher.LoadAsync();
    }

    private async Task OpenAsync()
    {
        _open = true;
        _history = null;
        _error = null;
        try
        {
            _history = await Publisher.GetItemHistoryAsync(Kind, Id, File);
        }
        catch (PublishException ex)
        {
            _error = ex.Message;
        }
    }

    private void Close() => _open = false;

    private static string Badge(ItemChange entry) => (entry.Before, entry.After) switch
    {
        (null, not null) => "dodana",
        (not null, null) => "usunięta",
        (null, null) => "nowa ikona",
        _ => entry.IconChanged ? "zmieniona, nowa ikona" : "zmieniona",
    };

    /// <summary>The role's icon as of that commit (repository and commit taken from the commit's address).</summary>
    private string? IconAt(ItemChange entry)
    {
        var match = System.Text.RegularExpressions.Regex.Match(entry.Url, @"github\.com/([^/]+/[^/]+)/commit/");
        return Kind == "role" && match.Success
            ? $"https://raw.githubusercontent.com/{match.Groups[1].Value}/{entry.Sha}/data/icons/{Id}.png"
            : null;
    }
}
