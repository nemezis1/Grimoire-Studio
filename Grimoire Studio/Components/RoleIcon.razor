@inject LocalRoles Local

@* A role created in the browser without its own icon has no file in data/icons; show the token art instead. *@
<img class="role-icon role-icon--@Size" src="@Local.IconUrl(Role.Id)" alt="" loading="lazy"
     onerror="this.onerror = null; this.src = 'Assets/token.png';" />

@code {
    [Parameter, EditorRequired]
    public Role Role { get; set; } = default!;

    /// <summary>sm, md or lg.</summary>
    [Parameter]
    public string Size { get; set; } = "md";
}
