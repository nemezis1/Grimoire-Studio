@using Grimoire_Studio.Generator

<select value="@Value" @onchange="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" style="font-family: '@Value'">
    @if (Custom.Count > 0)
    {
        <optgroup label="Własne">
            @foreach (var font in Custom)
            {
                <option value="@font" style="font-family: '@font'">@font</option>
            }
        </optgroup>
    }
    <optgroup label="Dołączone">
        @foreach (var font in TokenFonts.Bundled)
        {
            <option value="@font" style="font-family: '@font'">@font</option>
        }
    </optgroup>
    <optgroup label="Systemowe">
        @foreach (var font in TokenFonts.Common)
        {
            <option value="@font" style="font-family: '@font'">@font</option>
        }
    </optgroup>
</select>

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Fonts added in this browser (see TokenRenderer.LoadCustomFontsAsync).</summary>
    [Parameter]
    public IReadOnlyList<string> Custom { get; set; } = [];
}
