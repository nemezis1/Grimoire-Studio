@*
    Search across the site from the header: a magnifier button (and Ctrl+K or "/" on a keyboard) opens a dialog that
    finds roles, scripts, jinxes and teams as you type. Full screen on phones, a centred box on wider screens. With an
    empty field it lists the recently opened results, kept in this browser.
*@
@inject GameDataClient Client
@inject NavigationManager Nav
@inject LocalStore Store
@inject IJSRuntime JS
@implements IAsyncDisposable

<button class="search-open" title="Szukaj (Ctrl+K lub /)" aria-label="Szukaj" @onclick="OpenAsync">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M15.5 15.5 21 21" />
    </svg>
    <span class="search-open__label">Szukaj</span>
    <kbd class="search-open__key">Ctrl K</kbd>
    <kbd class="search-open__key">/</kbd>
</button>

@if (_open)
{
    <div class="search-backdrop" @onclick="CloseAsync"></div>
    <div class="search-dialog" role="dialog" aria-modal="true" aria-label="Szukaj w Grimoire Studio">
        <div class="search-dialog__head">
            <svg class="search-dialog__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <circle cx="10.5" cy="10.5" r="6.5" />
                <path d="M15.5 15.5 21 21" />
            </svg>
            <input @ref="_input" class="search-dialog__input" type="search" enterkeyhint="search" autocomplete="off" spellcheck="false"
                   placeholder="Rola, skrypt, jinx, drużyna…" aria-label="Szukaj" aria-controls="search-results"
                   aria-activedescendant="@(Hits.Count > 0 ? $"search-hit-{_active}" : null)"
                   value="@_query" @oninput="OnInput" />
            <button class="search-dialog__close" aria-label="Zamknij" title="Zamknij (Esc)" @onclick="CloseAsync">✕</button>
        </div>

        <div id="search-results" class="search-dialog__results" role="listbox">
            @if (_data is null)
            {
                <p class="notice search-dialog__note">Wczytywanie…</p>
            }
            else if (_query.Trim().Length == 0)
            {
                @if (_recentHits.Count > 0)
                {
                    <h3 class="search-group__label">Ostatnio otwierane</h3>
                    <ul class="search-group">
                        @foreach (var hit in _recentHits)
                        {
                            @Hit(hit)
                        }
                    </ul>
                }
                else
                {
                    <p class="notice search-dialog__note">Wpisz nazwę roli, skryptu, jinxa lub drużyny: po polsku albo po angielsku.</p>
                }
            }
            else if (_groups.Count == 0)
            {
                <p class="notice search-dialog__note">Nic nie pasuje do „@_query.Trim()”.</p>
            }
            else
            {
                @foreach (var group in _groups)
                {
                    <h3 class="search-group__label">
                        @group.Label <span class="muted">@group.Hits.Count</span>
                    </h3>
                    <ul class="search-group">
                        @foreach (var hit in group.Hits.Take(SiteSearch.PerGroup))
                        {
                            @Hit(hit)
                        }
                    </ul>
                    @if (group.Hits.Count > SiteSearch.PerGroup && group.MoreHref is { } more)
                    {
                        <a class="search-group__more" href="@more" @onclick="() => LeaveAsync(more)" @onclick:preventDefault="true">
                            Pokaż wszystkie (@group.Hits.Count) →
                        </a>
                    }
                }
            }
        </div>
    </div>
}

@code {
    private const string RecentKey = "grimoire-studio.search-recent";
    private const int MaxRecent = 8;

    private bool _open;
    private bool _focusPending;
    private string _query = string.Empty;
    private int _active;
    private GameData? _data;
    private IReadOnlyList<SearchGroup> _groups = [];
    private List<string> _recent = [];
    private IReadOnlyList<SearchHit> _recentHits = [];
    private ElementReference _input;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GlobalSearch>? _self;

    /// <summary>The results in the order the arrows go through them.</summary>
    private IReadOnlyList<SearchHit> Hits => _query.Trim().Length == 0
        ? _recentHits
        : _groups.SelectMany(g => g.Hits.Take(SiteSearch.PerGroup)).ToList();

    private RenderFragment Hit(SearchHit hit) => __builder =>
    {
        var index = Hits.ToList().IndexOf(hit);
        var active = index == _active;
        <li>
            <a id="search-hit-@index" class="search-hit @(active ? "search-hit--active" : null) @(hit.Team is null ? null : $"team--{hit.Team}")"
               style="@(hit.Team is null ? null : Teams.Style(hit.Team))" role="option" aria-selected="@active"
               href="@hit.Href" @onclick="() => OpenHitAsync(hit)" @onclick:preventDefault="true" @onmousemove="() => Mark(index)">
                @if (hit.Role is { } role)
                {
                    <RoleIcon Role="role" Size="sm" />
                }
                else if (hit.Script is { } script)
                {
                    <img class="search-hit__picture" src="@GameDataClient.EditionIconUrl(script)" alt="" loading="lazy" />
                }
                else
                {
                    <span class="search-hit__swatch" aria-hidden="true"></span>
                }
                <span class="search-hit__text">
                    <span class="search-hit__title">@hit.Title</span>
                    @if (!string.IsNullOrWhiteSpace(hit.Subtitle))
                    {
                        <span class="search-hit__subtitle">@hit.Subtitle</span>
                    }
                </span>
            </a>
        </li>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/search.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _self);
        }

        if (_focusPending && _open && _module is not null)
        {
            _focusPending = false;
            await _module.InvokeVoidAsync("opened", _input);
        }
    }

    [JSInvokable]
    public Task OpenFromKey() => OpenAsync();

    [JSInvokable]
    public async Task CloseFromKey()
    {
        await CloseAsync();
        StateHasChanged();
    }

    /// <summary>The back button closed the search; the history entry is already gone.</summary>
    [JSInvokable]
    public async Task CloseFromBack()
    {
        _open = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("closed", true);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task Move(int step)
    {
        var count = Hits.Count;
        if (count == 0)
        {
            return;
        }

        _active = (_active + step + count) % count;
        StateHasChanged();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("reveal", $"#search-hit-{_active}");
        }
    }

    [JSInvokable]
    public async Task Choose()
    {
        if (Hits.ElementAtOrDefault(_active) is { } hit)
        {
            await OpenHitAsync(hit);
        }
    }

    private async Task OpenAsync()
    {
        if (_open)
        {
            return;
        }

        _open = true;
        _focusPending = true;
        _active = 0;
        StateHasChanged();

        _data = await Client.GetAsync();
        _recent = await LoadRecentAsync();
        _recentHits = _recent.Select(key => SearchHit.Resolve(_data, key)).OfType<SearchHit>().ToList();
        Search();
        StateHasChanged();
    }

    private async Task CloseAsync()
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("closed", false);
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _active = 0;
        Search();
    }

    private void Mark(int index)
    {
        if (_active != index)
        {
            _active = index;
        }
    }

    private void Search() => _groups = _data is null ? [] : SiteSearch.Find(_data, _query);

    private async Task OpenHitAsync(SearchHit hit)
    {
        _recent.Remove(hit.Key);
        _recent.Insert(0, hit.Key);
        if (_recent.Count > MaxRecent)
        {
            _recent.RemoveRange(MaxRecent, _recent.Count - MaxRecent);
        }

        await Store.SetSettingAsync(RecentKey, System.Text.Json.JsonSerializer.Serialize(_recent));
        await LeaveAsync(hit.Href);
    }

    /// <summary>Closes the search and opens <paramref name="href"/> in place of the search's history entry.</summary>
    private async Task LeaveAsync(string href)
    {
        _open = false;
        _query = string.Empty;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("closed", true);
        }

        Nav.NavigateTo(href, replace: true);
    }

    private async Task<List<string>> LoadRecentAsync()
    {
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(await Store.GetSettingAsync(RecentKey) ?? "[]") ?? [];
        }
        catch (System.Text.Json.JsonException)
        {
            return [];
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away.
            }
        }

        _self?.Dispose();
    }
}
