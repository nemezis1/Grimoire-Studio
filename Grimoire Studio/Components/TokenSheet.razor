@using System.Globalization
@using Grimoire_Studio.Generator

@* A4 pages at real size (mm). On screen they are scaled down; when printed they come out 1:1. *@
<div class="sheet-pages">
    @if (Items.Count == 0)
    {
        @* An empty page keeps the panel as wide as with tokens, so its buttons stay in place. *@
        <div class="sheet-page sheet-page--empty" aria-label="Pusta strona"></div>
    }
    @{ var pageNumber = 0; }
    @foreach (var page in SheetLayout.Pack(Items))
    {
        pageNumber++;
        <div class="sheet-page" aria-label="Strona @pageNumber">
            @foreach (var placement in page)
            {
                var item = placement.Item;
                <div class="sheet-token @(item == Editing ? "sheet-token--editing" : null)"
                     style="left: @Mm(placement.X); top: @Mm(placement.Y); width: @Mm(placement.Diameter); height: @Mm(placement.Diameter);">
                    @if (item.ImageUrl is not null)
                    {
                        <img src="@item.ImageUrl" alt="@item.Settings.Text" />
                    }
                    <div class="sheet-token__actions">
                        @* Drawn icons: text symbols sit at different heights in different fonts. *@
                        <button title="Edytuj" aria-label="Edytuj" @onclick="() => OnEdit.InvokeAsync(item)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z M14 6l4 4" /></svg>
                        </button>
                        <button title="Duplikuj" aria-label="Duplikuj" @onclick="() => OnDuplicate.InvokeAsync(item)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /></svg>
                        </button>
                        <button title="Usuń" aria-label="Usuń" @onclick="() => OnRemove.InvokeAsync(item)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SheetItem> Items { get; set; } = [];

    [Parameter]
    public SheetItem? Editing { get; set; }

    [Parameter]
    public EventCallback<SheetItem> OnEdit { get; set; }

    [Parameter]
    public EventCallback<SheetItem> OnDuplicate { get; set; }

    [Parameter]
    public EventCallback<SheetItem> OnRemove { get; set; }

    private static string Mm(double value) => value.ToString("0.##", CultureInfo.InvariantCulture) + "mm";
}
