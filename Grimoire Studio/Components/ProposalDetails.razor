@* Folded list of a proposal's changes; a partly approved one is split into accepted and rejected items. *@

<details class="proposal-changes">
    <summary>Pokaż zmiany</summary>
    @if (Proposal.Status != ProposalStatus.Pending && Proposal.Before is null)
    {
        <p class="muted small">
            Zgłoszenie rozpatrzone, zanim zapamiętywano stan sprzed zmian: porównanie z danymi strony, które mogą już
            zawierać te zmiany. Pełne różnice pokazuje „Historia zmian” na stronie roli, skryptu lub jinxa.
        </p>
    }
    @* Older proposals did not record the accepted items; they are shown as one list. *@
    @if (Proposal.Status == ProposalStatus.Approved && Proposal.ApprovedKeys.Count > 0 && Proposal.ApprovedKeys.Count < Proposal.Changes.Count)
    {
        var approved = Proposal.ApprovedKeys.ToHashSet();
        var rejected = Proposal.Changes.Keys().Where(k => !approved.Contains(k)).ToHashSet();
        <h4 class="proposal-changes__part">Przyjęte</h4>
        <ChangeSetView Changes="Proposal.Changes.Only(approved)" Base="Base" Data="Data" DetailsOpen="true" />
        <h4 class="proposal-changes__part">Odrzucone</h4>
        <ChangeSetView Changes="Proposal.Changes.Only(rejected)" Base="Base" Data="Data" DetailsOpen="true" />
    }
    else
    {
        <ChangeSetView Changes="Proposal.Changes" Base="Base" Data="Data" DetailsOpen="true" />
    }
</details>

@code {
    [Parameter, EditorRequired]
    public Proposal Proposal { get; set; } = default!;

    /// <summary>
    /// Data to compare with. For a decided proposal pass <see cref="Proposal.DecidedBase"/>: the wiki and later the data
    /// folder contain the approved changes, so comparing with them would show no differences.
    /// </summary>
    [Parameter, EditorRequired]
    public GameData Base { get; set; } = default!;

    [Parameter, EditorRequired]
    public GameData Data { get; set; } = default!;
}
