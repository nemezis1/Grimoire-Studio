@using System.Text.Json
@using Grimoire_Studio.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    Print preview of a script: settings on the left, A4 pages on the right. The pages are printed as they are shown
    (wwwroot/css/app.css, "Script print dialog"); content that does not fit is shrunk to its page.
*@
<div class="print-dialog" role="dialog" aria-modal="true" aria-label="Wydruk skryptu">
    <aside class="print-dialog__settings">
        <h2>Wydruk skryptu</h2>

        <section class="panel">
            <h3>Arkusz postaci</h3>
            <div class="checks checks--column">
                <label><input type="radio" name="columns" checked="@(_options.Columns == 1)" @onchange="() => Update(o => o.Columns = 1)" /> Jedna kolumna</label>
                <label><input type="radio" name="columns" checked="@(_options.Columns == 2)" @onchange="() => Update(o => o.Columns = 2)" /> Dwie kolumny</label>
                <label><input type="checkbox" checked="@_options.AbilityBesideName" @onchange="e => Update(o => o.AbilityBesideName = e.Value is true)" /> Opis roli obok nazwy</label>
                <label><input type="checkbox" checked="@_options.ShowPlayerCount" @onchange="e => Update(o => o.ShowPlayerCount = e.Value is true)" /> Tabela liczby graczy</label>
                <label><input type="checkbox" checked="@_options.IncludeExtras" @onchange="e => Update(o => o.IncludeExtras = e.Value is true)" /> Wędrowcy, legendy i jinxy (osobna strona)</label>
            </div>
        </section>

        <section class="panel">
            <h3>Kolejność nocy</h3>
            <div class="checks checks--column">
                <label><input type="checkbox" checked="@_options.IncludeNightOrder" @onchange="e => Update(o => o.IncludeNightOrder = e.Value is true)" /> Drukuj kolejność nocy</label>
                <label><input type="checkbox" checked="@_options.NightIncludesTravellers" @onchange="e => Update(o => o.NightIncludesTravellers = e.Value is true)" /> Uwzględnij Wędrowców</label>
                <label><input type="checkbox" checked="@_options.NightShowsEvilInfo" @onchange="e => Update(o => o.NightShowsEvilInfo = e.Value is true)" /> Informacje dla sługusów i demona</label>
                <label><input type="checkbox" checked="@_options.NightShowsAbility" @onchange="e => Update(o => o.NightShowsAbility = e.Value is true)" /> Opis roli</label>
                <label><input type="checkbox" checked="@_options.NightShowsReminder" @onchange="e => Update(o => o.NightShowsReminder = e.Value is true)" /> Opis dla narratora</label>
                <label><input type="checkbox" checked="@_options.FlipOtherNights" @onchange="e => Update(o => o.FlipOtherNights = e.Value is true)" /> Pozostałe noce do góry nogami</label>
            </div>
        </section>

        <section class="panel">
            <h3>Wielkość tekstu</h3>
            <PrintSlider Label="Skala tekstu" Min="0.8" Max="1.4" Step="0.05" Value="_options.Scale" ValueChanged="v => Update(o => o.Scale = v)" />
            <p class="muted small">Treść, która się nie mieści, jest automatycznie pomniejszana do swojej strony.</p>
        </section>

        <section class="panel">
            <h3>Podgląd</h3>
            <PrintSlider Label="Wielkość podglądu" Min="0.4" Max="1.5" Step="0.05" Value="_options.PreviewZoom" ValueChanged="v => Update(o => o.PreviewZoom = v)" />
            <p class="muted small">Zmienia tylko widok na ekranie, nie wydruk.</p>
        </section>

        <div class="field-row">
            <button class="button" @onclick="PrintAsync">Drukuj / zapisz PDF</button>
            <button class="button button--ghost" @onclick="() => Update(o => Reset(o))">Ustawienia domyślne</button>
            <button class="button button--ghost" @onclick="OnClose">Zamknij</button>
        </div>
        <p class="muted small">W oknie drukowania wybierz papier A4 i skalę 100%.</p>
    </aside>

    <div class="print-dialog__preview" @ref="_preview">
        <div class="print-doc" style="--print-scale: @Css(_options.Scale); --preview-zoom: @Css(_options.PreviewZoom)">
            @{
                var roles = Data.RolesOf(Script);
                var core = roles.Where(r => r.Team <= Team.Demon).GroupBy(r => r.Team).OrderBy(g => g.Key).ToList();
                var extras = roles.Where(r => r.Team > Team.Demon).GroupBy(r => r.Team).OrderBy(g => g.Key).ToList();
                var jinxes = roles
                    .SelectMany(r => Data.JinxesFor(r.Id, Script).Select(j => (Role: r, j.Other, j.Jinx)))
                    .DistinctBy(x => x.Jinx)
                    .ToList();
                var showExtras = _options.IncludeExtras && (extras.Count > 0 || jinxes.Count > 0);
            }

            <PrintPage Title="@Script.Name" Script="Script">
                @foreach (var group in core)
                {
                    <PrintRoleGroup Team="group.Key" Roles="group.ToList()" Columns="_options.Columns" AbilityBesideName="_options.AbilityBesideName" />
                }
            </PrintPage>

            @if (showExtras || _options.ShowPlayerCount)
            {
                <PrintPage Title="@Script.Name" Subtitle="@(showExtras ? "Wędrowcy, legendy i zasady specjalne" : "Liczba graczy")" Script="Script">
                    <ChildContent>
                    @foreach (var group in showExtras ? extras : [])
                    {
                        <PrintRoleGroup Team="group.Key" Roles="group.ToList()" Columns="_options.Columns" AbilityBesideName="_options.AbilityBesideName" />
                    }
                    @if (showExtras && jinxes.Count > 0)
                    {
                        <section class="print-group">
                            <h2>Zasady specjalne (jinxy)</h2>
                            <ul class="print-jinxes print-columns--@_options.Columns">
                                @foreach (var (role, other, jinx) in jinxes)
                                {
                                    <li>
                                        <span class="print-jinxes__pair"><RoleIcon Role="role" Size="sm" /><RoleIcon Role="other" Size="sm" /> @role.NamePl + @other.NamePl</span>
                                        <p>@jinx.ReasonPl</p>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                    </ChildContent>
                    <Bottom>
                        @if (_options.ShowPlayerCount)
                        {
                            <table class="player-count">
                                <tr>
                                    <th>Gracze</th>
                                    @foreach (var row in PlayerCount.Table)
                                    {
                                        <td>@(row.Players == PlayerCount.MaxPlayers ? "15+" : row.Players)</td>
                                    }
                                </tr>
                                @foreach (var (team, count) in new (Team, Func<PlayerCount, int>)[]
                                {
                                    (Team.Townsfolk, c => c.Townsfolk),
                                    (Team.Outsider, c => c.Outsiders),
                                    (Team.Minion, c => c.Minions),
                                    (Team.Demon, c => c.Demons),
                                })
                                {
                                    <tr class="team--@TeamText.Slug(team)">
                                        <th>@TeamText.Plural(team)</th>
                                        @foreach (var row in PlayerCount.Table)
                                        {
                                            <td>@count(row)</td>
                                        }
                                    </tr>
                                }
                            </table>
                        }
                    </Bottom>
                </PrintPage>
            }

            @if (_options.IncludeNightOrder)
            {
                <PrintPage Title="@Script.Name" Subtitle="Kolejność nocy" Script="Script" FillHeight="true">
                    <div class="print-nights">
                        <PrintNightList Title="Pierwsza noc" Steps="NightSteps(true)" FirstNight="true" ShowAbility="_options.NightShowsAbility" ShowReminder="_options.NightShowsReminder" />
                        <PrintNightList Title="Pozostałe noce" Steps="NightSteps(false)" FirstNight="false" ShowAbility="_options.NightShowsAbility" ShowReminder="_options.NightShowsReminder" Flipped="_options.FlipOtherNights" />
                    </div>
                </PrintPage>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Script Script { get; set; } = default!;

    [Parameter, EditorRequired]
    public GameData Data { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private ScriptPrintOptions _options = new();
    private ElementReference _preview;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/localStore.js");
        var json = await _module.InvokeAsync<string?>("getItem", ScriptPrintOptions.StorageKey);
        try
        {
            _options = json is null ? new() : JsonSerializer.Deserialize<ScriptPrintOptions>(json, Json) ?? new();
        }
        catch (JsonException)
        {
            _options = new();
        }
    }

    // Fit after every change, once fonts are ready so measurements use the final glyphs.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("preloadFonts", (object)new[] { ScriptPrintOptions.TitleFont });
            await _module.InvokeVoidAsync("fitPages", _preview);
        }
    }

    private static string Css(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private IReadOnlyList<NightStep> NightSteps(bool firstNight) =>
        Data.NightSteps(Script, firstNight, _options.NightShowsEvilInfo)
            .Where(s => _options.NightIncludesTravellers || s.Role?.Team != Team.Traveler)
            .ToList();

    private async Task Update(Action<ScriptPrintOptions> change)
    {
        change(_options);
        if (_module is not null)
        {
            await _module.InvokeAsync<bool>("setItem", ScriptPrintOptions.StorageKey, JsonSerializer.Serialize(_options, Json));
        }
    }

    private static void Reset(ScriptPrintOptions options)
    {
        var defaults = new ScriptPrintOptions();
        options.Columns = defaults.Columns;
        options.AbilityBesideName = defaults.AbilityBesideName;
        options.Scale = defaults.Scale;
        options.ShowPlayerCount = defaults.ShowPlayerCount;
        options.IncludeExtras = defaults.IncludeExtras;
        options.IncludeNightOrder = defaults.IncludeNightOrder;
        options.NightIncludesTravellers = defaults.NightIncludesTravellers;
        options.NightShowsAbility = defaults.NightShowsAbility;
        options.NightShowsReminder = defaults.NightShowsReminder;
        options.NightShowsEvilInfo = defaults.NightShowsEvilInfo;
        options.FlipOtherNights = defaults.FlipOtherNights;
        options.PreviewZoom = defaults.PreviewZoom;
    }

    private async Task PrintAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("print", (object)new[] { ScriptPrintOptions.TitleFont });
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Page is going away.
            }
        }
    }
}
